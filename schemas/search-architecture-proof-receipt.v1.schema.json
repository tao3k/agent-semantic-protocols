{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.dev/schemas/search-architecture-proof-receipt.v1.schema.json",
  "title": "Search Architecture Lean Proof Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "inventoryDigest",
    "modelDigest",
    "proofDigest",
    "state",
    "unknownNodes",
    "capabilityViolations",
    "legacyNodes",
    "productionToLegacyPaths",
    "legacyToAuthorityPaths",
    "axioms"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.search-architecture-proof-receipt" },
    "schemaVersion": { "const": "1" },
    "inventoryDigest": { "$ref": "#/$defs/digest" },
    "modelDigest": { "$ref": "#/$defs/digest" },
    "proofDigest": { "$ref": "#/$defs/digest" },
    "state": { "enum": ["admitted", "rejected"] },
    "unknownNodes": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "capabilityViolations": { "type": "array", "items": { "$ref": "#/$defs/violation" } },
    "legacyNodes": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
    "productionToLegacyPaths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "legacyToAuthorityPaths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "axioms": { "type": "array", "maxItems": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "admitted" } } },
      "then": {
        "properties": {
          "unknownNodes": { "maxItems": 0 },
          "capabilityViolations": { "maxItems": 0 },
          "legacyNodes": { "maxItems": 0 },
          "productionToLegacyPaths": { "maxItems": 0 },
          "legacyToAuthorityPaths": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "rejected" } } },
      "then": {
        "anyOf": [
          { "properties": { "unknownNodes": { "minItems": 1 } } },
          { "properties": { "capabilityViolations": { "minItems": 1 } } },
          { "properties": { "legacyNodes": { "minItems": 1 } } },
          { "properties": { "productionToLegacyPaths": { "minItems": 1 } } },
          { "properties": { "legacyToAuthorityPaths": { "minItems": 1 } } }
        ]
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "declaredOwner", "capability", "sourceSelector"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "declaredOwner": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/identifier" },
        "sourceSelector": { "type": "string", "minLength": 1 }
      }
    }
  }
}
