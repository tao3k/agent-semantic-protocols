{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/query-playbook-materialization-request.v1.schema.json",
  "title": "Query Playbook Materialization Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "protocolId",
    "protocolVersion",
    "settlementBinding",
    "searchRequestId",
    "materializationSetDigest",
    "selectors",
    "proofDependencies",
    "projection"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.query-playbook-materialization-request"},
    "schemaVersion": {"const": "1"},
    "protocolId": {"const": "agent.semantic-protocols.query-playbook"},
    "protocolVersion": {"const": "1"},
    "settlementBinding": {"$ref": "#/$defs/settlementBinding"},
    "searchRequestId": {"type": "string", "minLength": 1},
    "materializationSetDigest": {"$ref": "#/$defs/digest"},
    "selectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/selector"}
    },
    "proofDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "projection": {"enum": ["matches", "source", "callable-skeleton"]}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "selector": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+#item/[^\\s]+$(?![\\s\\S])"
    },
    "settlementBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceIdentity",
        "sourceGenerationDigest",
        "providerCatalogDigest",
        "topologyLibraryDigest",
        "topologyGenerationDigest",
        "structuralTopologyDigest",
        "semanticTopologyDigest",
        "inferenceProgramDigest"
      ],
      "properties": {
        "workspaceIdentity": {"type": "string", "minLength": 1},
        "sourceGenerationDigest": {"$ref": "#/$defs/digest"},
        "providerCatalogDigest": {"$ref": "#/$defs/digest"},
        "topologyLibraryDigest": {"$ref": "#/$defs/digest"},
        "topologyGenerationDigest": {"$ref": "#/$defs/digest"},
        "structuralTopologyDigest": {"$ref": "#/$defs/digest"},
        "semanticTopologyDigest": {"$ref": "#/$defs/digest"},
        "inferenceProgramDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
