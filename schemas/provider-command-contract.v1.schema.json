{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.github.io/agent-semantic-protocols/schemas/provider-command-contract.v1.schema.json",
  "title": "Provider Command Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "providerId",
    "languageIds",
    "operations",
    "contractDigest"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.provider-command-contract"
    },
    "schemaVersion": {
      "const": "1"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "languageIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    },
    "contractDigest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "requestSchemaId",
        "responseSchemaId"
      ],
      "properties": {
        "transport": {
          "enum": [
            "stdin-json",
            "argv"
          ]
        },
        "requestSchemaId": {
          "type": "string",
          "minLength": 1
        },
        "responseSchemaId": {
          "type": "string",
          "minLength": 1
        },
        "projections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "source",
              "callable-skeleton",
              "metadata"
            ]
          }
        }
      }
    }
  }
}
