{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/semantic-graph-turbo-cache-entry.v1.schema.json",
  "title": "ASP semantic Graph Turbo cache entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "snapshotDigest",
    "workspaceGenerationRootDigest",
    "profile",
    "algorithm",
    "seedDigest",
    "parameterDigest",
    "proposalStatus",
    "result"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.semantic-graph-turbo-cache-entry"},
    "schemaVersion": {"const": "1"},
    "snapshotDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspaceGenerationRootDigest": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "algorithm": {"type": "string", "minLength": 1},
    "seedDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parameterDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposalStatus": {"enum": ["candidate", "proposed", "heuristic", "partial"]},
    "result": {"type": "object"}
  }
}
