{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/agent-org-topology-evidence.v1.schema.json",
  "title": "Agent Org Topology Evidence V1",
  "description": "Exact content-bound Query evidence prepared by Live Corpus for an external reasoning Agent; it is not an Agent result or a Search mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "caseId", "resourceId",
    "sourceGenerationDigest", "baseTopologyGenerationDigest", "anchorSelector", "scopeSelectors",
    "composedSearchOperationId", "composedSearchScheme", "composedSearchSchemeDigest",
    "sourceQueryOperationId", "sourceMaterializations",
    "callableSkeletonOperationId", "callableSkeletonMaterializations",
    "evidenceDigest", "prompt", "promptDigest", "requiredRelationKinds", "terminal"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.agent-org-topology-evidence"},
    "schemaVersion": {"const": "1"},
    "caseId": {"type": "string", "minLength": 1},
    "resourceId": {"type": "string", "minLength": 1},
    "sourceGenerationDigest": {"$ref": "#/$defs/digest"},
    "baseTopologyGenerationDigest": {"$ref": "#/$defs/digest"},
    "anchorSelector": {"type": "string", "minLength": 1},
    "scopeSelectors": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "composedSearchOperationId": {"type": "string", "minLength": 1},
    "composedSearchScheme": {"type": "string", "pattern": "^\\s*\\(search\\s"},
    "composedSearchSchemeDigest": {"$ref": "#/$defs/digest"},
    "sourceQueryOperationId": {"type": "string", "minLength": 1},
    "sourceMaterializations": {"$ref": "#/$defs/materializations"},
    "callableSkeletonOperationId": {"type": "string", "minLength": 1},
    "callableSkeletonMaterializations": {"$ref": "#/$defs/materializations"},
    "evidenceDigest": {"$ref": "#/$defs/digest"},
    "prompt": {"type": "string", "minLength": 1},
    "promptDigest": {"$ref": "#/$defs/digest"},
    "requiredRelationKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "terminalCount", "reasonKind"],
      "properties": {
        "state": {"const": "ready"},
        "terminalCount": {"const": 1},
        "reasonKind": {"type": "null"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"},
    "materializations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "bytesBase64"],
        "properties": {
          "selector": {"type": "string", "minLength": 1},
          "bytesBase64": {"type": "string", "minLength": 1, "contentEncoding": "base64"}
        }
      }
    }
  }
}
