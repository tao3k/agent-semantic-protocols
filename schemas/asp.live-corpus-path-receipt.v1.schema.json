{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/asp.live-corpus-path-receipt.v1.schema.json",
  "title": "ASP live corpus path receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "resourceId",
    "remote",
    "revision",
    "repositoryPath",
    "checkoutPath"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.live-corpus-path-receipt"
    },
    "schemaVersion": { "const": "1" },
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "remote": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repositoryPath": { "type": "string", "minLength": 1 },
    "checkoutPath": { "type": "string", "minLength": 1 }
  }
}
