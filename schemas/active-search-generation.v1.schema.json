{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/active-search-generation.v1.schema.json",
  "title": "Active Search Generation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "workspaceIdentity",
    "publicationEpoch",
    "generationDigest",
    "sourceRootDigest",
    "providerCatalogDigest",
    "projectionCapabilityDigest",
    "providerContracts",
    "residentSections"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.active-search-generation" },
    "schemaVersion": { "const": "1" },
    "workspaceIdentity": { "type": "string", "minLength": 1 },
    "publicationEpoch": { "type": "integer", "minimum": 1 },
    "generationDigest": { "$ref": "#/$defs/digest" },
    "sourceRootDigest": { "$ref": "#/$defs/digest" },
    "providerCatalogDigest": { "$ref": "#/$defs/digest" },
    "projectionCapabilityDigest": { "$ref": "#/$defs/digest" },
    "providerContracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerId", "artifactDigest", "contractDigest"],
        "properties": {
          "providerId": { "type": "string", "minLength": 1 },
          "artifactDigest": { "$ref": "#/$defs/digest" },
          "contractDigest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "residentSections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "lexical",
          "owner",
          "selector",
          "relation",
          "graph",
          "exact-source",
          "callable-skeleton"
        ]
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    }
  }
}
