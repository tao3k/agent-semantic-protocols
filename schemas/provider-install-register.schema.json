{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-install-register.schema.json",
  "title": "Provider Install Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaId", "schemaVersion", "providers"],
  "properties": {
    "$schema": {
      "const": "https://schemas.agent-semantic-protocols.dev/provider-install-register.schema.json"
    },
    "schemaId": {
      "const": "agent.semantic-protocols.provider-install-register"
    },
    "schemaVersion": { "const": "1" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageId",
        "providerId",
        "binary",
        "sourceRoot",
        "workspaceInstall",
        "buildBinding",
        "artifactDomain"
      ],
      "properties": {
        "languageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "providerId": {
          "type": "string",
          "pattern": "^asp-[a-z][a-z0-9-]*$"
        },
        "binary": {
          "type": "string",
          "pattern": "^asp-[a-z][a-z0-9-]*$"
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "workspaceInstall": {
          "type": "string",
          "minLength": 1
        },
        "buildBinding": {
          "const": "provider-workspace-install"
        },
        "artifactDomain": {
          "enum": ["checkout", "state-home-provider-staging"]
        }
      }
    }
  }
}
