{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-merkle-owner-read-receipt.v1.schema.json",
  "title": "Runtime Merkle Owner Read Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "state",
    "workspaceIdentity",
    "projectRoot",
    "activeEpoch",
    "generationDigest",
    "rootDigest",
    "ownerPath"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-merkle-owner-read-receipt"
    },
    "schemaVersion": { "const": "1" },
    "state": { "enum": ["owner", "owner-missing"] },
    "workspaceIdentity": { "type": "string", "minLength": 1 },
    "projectRoot": { "type": "string", "minLength": 1 },
    "activeEpoch": { "type": "integer", "minimum": 1 },
    "generationDigest": { "$ref": "#/$defs/digest" },
    "rootDigest": { "$ref": "#/$defs/digest" },
    "ownerPath": { "$ref": "#/$defs/ownerPath" },
    "sourceBlobDigest": { "$ref": "#/$defs/digest" },
    "ownerSubtreeDigest": { "$ref": "#/$defs/digest" },
    "inclusionProof": {
      "type": "array",
      "items": { "$ref": "#/$defs/inclusionStep" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "ownerPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "inclusionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "digest"],
      "properties": {
        "side": { "enum": ["left", "right"] },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "owner" } } },
      "then": {
        "required": [
          "sourceBlobDigest",
          "ownerSubtreeDigest",
          "inclusionProof"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["sourceBlobDigest"] },
            { "required": ["ownerSubtreeDigest"] },
            { "required": ["inclusionProof"] }
          ]
        }
      }
    }
  ]
}
