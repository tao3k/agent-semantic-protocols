{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/projection-evidence-context.v1.schema.json",
  "title": "Projection Evidence Context v1",
  "description": "Runtime-owned identity interned once per immutable generation and referenced by derived projections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "evidenceContextRef",
    "languageId",
    "providerId",
    "generationIdentityDigest",
    "parserIdentityDigest",
    "queryPackDigest"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.projection-evidence-context"
    },
    "schemaVersion": {
      "const": "1"
    },
    "evidenceContextRef": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "generationIdentityDigest": {
      "$ref": "#/$defs/digest"
    },
    "parserIdentityDigest": {
      "$ref": "#/$defs/digest"
    },
    "queryPackDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
