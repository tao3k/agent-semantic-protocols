{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/search-generation-graph-request.v1.schema.json",
  "title": "Search generation graph request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "identity", "contentGenerationDigest", "sourceSnapshot", "workspaceGeneration", "ownerPaths", "relations"],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.search-generation-graph-request"},
    "schemaVersion": {"const": "1"},
    "identity": {"$ref": "#/$defs/identity"},
    "contentGenerationDigest": {"$ref": "#/$defs/digest"},
    "sourceSnapshot": {"$ref": "source-snapshot-evidence.v1.schema.json#/$defs/sourceSnapshot"},
    "workspaceGeneration": {"$ref": "workspace-generation-root-evidence.v1.schema.json"},
    "ownerPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "relations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "workspaceId", "sourceRootDigest", "providerDigest", "schemaDigest", "generationCandidateDigest"],
      "properties": {
        "projectId": {"type": "string", "minLength": 1},
        "workspaceId": {"type": "string", "minLength": 1},
        "sourceRootDigest": {"$ref": "#/$defs/digest"},
        "providerDigest": {"$ref": "#/$defs/digest"},
        "schemaDigest": {"$ref": "#/$defs/digest"},
        "generationCandidateDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "digest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}}
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "kind", "to"],
      "properties": {"from": {"$ref": "#/$defs/endpoint"}, "kind": {"type": "string", "minLength": 1}, "to": {"$ref": "#/$defs/endpoint"}}
    }
  }
}
