{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/workspace-merkle-delta.v1.schema.json",
  "title": "Workspace Merkle Delta V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "algorithm",
    "workspaceIdentity",
    "mutationId",
    "baseGenerationDigest",
    "baseRootDigest",
    "operations",
    "successorRootDigest",
    "dirtyPathsDigest",
    "touchedLeafCount",
    "writtenNodeCount",
    "reusedNodeCount",
    "fullMerkleRebuilds"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.workspace-merkle-delta" },
    "schemaVersion": { "const": "1" },
    "algorithm": { "const": "workspace-path-radix-merkle-v1" },
    "workspaceIdentity": { "type": "string", "minLength": 1 },
    "mutationId": { "type": "string", "minLength": 1 },
    "baseGenerationDigest": { "$ref": "#/$defs/digest" },
    "baseRootDigest": { "$ref": "#/$defs/digest" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "successorRootDigest": { "$ref": "#/$defs/digest" },
    "dirtyPathsDigest": { "$ref": "#/$defs/digest" },
    "touchedLeafCount": { "type": "integer", "minimum": 1 },
    "writtenNodeCount": { "type": "integer", "minimum": 1 },
    "reusedNodeCount": { "type": "integer", "minimum": 0 },
    "fullMerkleRebuilds": { "const": 0 }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "ownerPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "upsert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ownerPath", "previousSourceBlobDigest", "sourceBlobDigest"],
      "properties": {
        "kind": { "const": "upsert" },
        "ownerPath": { "$ref": "#/$defs/ownerPath" },
        "previousSourceBlobDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "sourceBlobDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ownerPath", "previousSourceBlobDigest"],
      "properties": {
        "kind": { "const": "remove" },
        "ownerPath": { "$ref": "#/$defs/ownerPath" },
        "previousSourceBlobDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation": {
      "oneOf": [{ "$ref": "#/$defs/upsert" }, { "$ref": "#/$defs/remove" }]
    }
  }
}
