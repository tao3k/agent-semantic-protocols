{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.semantic-protocols.asp-python-graphs-runtime-artifact.v2",
  "title": "ASP Python Graphs immutable runtime artifact descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "artifactKind", "protocolId", "protocolVersion",
    "executionArtifactLocator", "commandArguments", "contentDigest",
    "executionCommandDigest", "artifactMetadataDigest", "publicationGeneration",
    "publicationNonce"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.asp-python-graphs-runtime-artifact" },
    "schemaVersion": { "const": "2" },
    "artifactKind": { "const": "standalone-executable" },
    "protocolId": { "const": "asp.python.graphs" },
    "protocolVersion": { "const": "1" },
    "executionArtifactLocator": { "type": "string", "pattern": "^/" },
    "commandArguments": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "not": { "pattern": "\\$\\{(?!socketPath\\})" } }
    },
    "contentDigest": { "$ref": "#/$defs/digest" },
    "executionCommandDigest": { "$ref": "#/$defs/digest" },
    "artifactMetadataDigest": { "$ref": "#/$defs/digest" },
    "publicationGeneration": { "type": "integer", "minimum": 1 },
    "publicationNonce": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^blake3-256:[0-9a-fA-F]{64}$" }
  }
}
