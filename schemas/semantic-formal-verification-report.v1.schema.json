{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/semantic-formal-verification-report.v1.schema.json",
  "title": "Semantic Formal Verification Report v1",
  "description": "Expanded report tying a proof receipt to verified claims, defensive-engineering assessment, and raw checker response artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "protocolId",
    "protocolVersion",
    "reportId",
    "receiptId",
    "schemaProjection",
    "packetProjection",
    "validatedClaims",
    "defensiveEngineeringAssessment",
    "rawAxleResponse"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.semantic-formal-verification-report"
    },
    "schemaVersion": {
      "const": "1"
    },
    "protocolId": {
      "const": "agent.semantic-protocols.formal-verification"
    },
    "protocolVersion": {
      "const": "1"
    },
    "reportId": {
      "$ref": "#/$defs/id"
    },
    "receiptId": {
      "$ref": "#/$defs/id"
    },
    "schemaProjection": {
      "$ref": "semantic-proof-definitions.v1.schema.json#/$defs/schemaProjection"
    },
    "packetProjection": {
      "$ref": "semantic-proof-definitions.v1.schema.json#/$defs/packetProjection"
    },
    "validatedClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "semantic-proof-definitions.v1.schema.json#/$defs/validatedClaim"
      }
    },
    "defensiveEngineeringAssessment": {
      "$ref": "semantic-proof-definitions.v1.schema.json#/$defs/defensiveEngineeringAssessment"
    },
    "rawAxleResponse": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]*$"
    }
  }
}
