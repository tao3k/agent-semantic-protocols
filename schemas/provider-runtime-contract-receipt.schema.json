{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/provider-runtime-contract-receipt.schema.json",
  "title": "Provider Runtime Contract Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "providerId",
    "languageId",
    "artifactDigest",
    "registrationDigest",
    "contractDigest",
    "transport",
    "operations"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.provider-runtime-contract-receipt"
    },
    "schemaVersion": { "const": "1" },
    "providerId": { "type": "string", "minLength": 1 },
    "languageId": { "type": "string", "minLength": 1 },
    "artifactDigest": { "$ref": "#/$defs/digest" },
    "registrationDigest": { "$ref": "#/$defs/digest" },
    "contractDigest": { "$ref": "#/$defs/digest" },
    "transport": { "const": "http-json" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[0-9a-f]{64}$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "requestSchema", "responseSchema"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "requestSchema": { "$ref": "provider-definitions.v1.schema.json#/$defs/schemaReference" },
        "responseSchema": { "$ref": "provider-definitions.v1.schema.json#/$defs/schemaReference" }
      }
    }
  }
}
