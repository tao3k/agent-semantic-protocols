{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/agent-action.v1.schema.json",
  "title": "Agent Action IR v1",
  "description": "Separates immutable Host invocation facts from parser-derived semantic capabilities and classified subjects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostInvocation", "semanticCapabilities", "subjects"],
  "properties": {
    "hostInvocation": { "$ref": "#/$defs/hostInvocation" },
    "semanticCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/semanticCapability" }
    },
    "subjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/subject" }
    }
  },
  "$defs": {
    "actionKind": {
      "enum": ["read", "edit", "search", "enumerate", "execute", "unknown"]
    },
    "hostInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "toolName", "surface", "payload", "source"],
      "properties": {
        "action": { "$ref": "#/$defs/actionKind" },
        "toolName": { "type": "string" },
        "surface": { "type": "string", "minLength": 1 },
        "payload": {},
        "source": { "type": ["string", "null"] }
      }
    },
    "semanticCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "evidence"],
      "properties": {
        "action": { "$ref": "#/$defs/actionKind" },
        "evidence": {
          "enum": ["host-invocation", "shell-redirection"]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "kind"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "registered-language-source",
            "registered-language-source-pattern",
            "directory",
            "structural-selector",
            "other"
          ]
        }
      }
    }
  }
}
