{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/agent-action.v1.schema.json",
  "title": "Agent Action IR v1",
  "description": "Separates immutable Host invocation facts, subject-bound filesystem permission facts, projected semantic actions, and classified subjects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hostInvocation",
    "filesystemPermissions",
    "semanticCapabilities",
    "subjects"
  ],
  "properties": {
    "hostInvocation": { "$ref": "#/$defs/hostInvocation" },
    "filesystemPermissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/filesystemPermission" }
    },
    "semanticCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/semanticCapability" }
    },
    "subjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/subject" }
    }
  },
  "$defs": {
    "semanticActionKind": {
      "enum": ["read", "edit", "search", "enumerate", "execute", "unknown"]
    },
    "hostInvocationKind": {
      "enum": [
        "read",
        "edit",
        "search",
        "enumerate",
        "execute",
        "mcp",
        "spawn-agent",
        "unknown"
      ]
    },
    "hostInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "toolName", "surface", "payload", "source"],
      "properties": {
        "action": { "$ref": "#/$defs/hostInvocationKind" },
        "toolName": { "type": "string" },
        "surface": { "type": "string", "minLength": 1 },
        "payload": {},
        "source": { "type": ["string", "null"] }
      }
    },
    "semanticCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "evidence"],
      "properties": {
        "action": { "$ref": "#/$defs/semanticActionKind" },
        "evidence": {
          "enum": [
            "host-matcher",
            "configured-command-pattern",
            "reader-probe",
            "shell-redirection",
            "registered-source-operand"
          ]
        }
      }
    },
    "filesystemPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission", "source", "subject"],
      "properties": {
        "permission": { "enum": ["read", "write"] },
        "source": {
          "enum": [
            "host-matcher",
            "reader-probe",
            "shell-redirection"
          ]
        },
        "subject": { "type": ["string", "null"] }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "kind"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "registered-language-source",
            "registered-language-source-pattern",
            "directory",
            "structural-selector",
            "other"
          ]
        }
      }
    }
  }
}
