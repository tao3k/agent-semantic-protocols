{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/host-agent-lifecycle-attestation.v1.schema.json",
  "title": "Host Agent Lifecycle Attestation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "agentType",
    "canonicalPath",
    "childId",
    "observedAtUnixSeconds",
    "bindingFresh"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.host-agent-lifecycle-attestation"
    },
    "schemaVersion": { "const": "1" },
    "agentType": { "type": "string", "minLength": 1 },
    "canonicalPath": { "type": "string", "pattern": "^/root(?:/[^/]+)+$" },
    "childId": { "type": "string", "minLength": 1 },
    "observedAtUnixSeconds": { "type": "integer", "minimum": 0 },
    "bindingFresh": { "type": "boolean" }
  }
}
