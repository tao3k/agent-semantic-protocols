{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/global-resident-control.v1.schema.json",
  "title": "ASP Runtime Server Control",
  "oneOf": [
    {
      "$ref": "#/$defs/endpoint"
    },
    {
      "$ref": "#/$defs/requestBatch"
    },
    {
      "$ref": "#/$defs/receiptBatch"
    },
    {
      "$ref": "#/$defs/statusSnapshot"
    }
  ],
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "transportContractDigest",
        "ownerEpoch",
        "runtimeArtifactPath",
        "runtimeArtifactDigest",
        "bindingToken",
        "socketPath"
        ,"statusMemoryPath"
      ],
      "properties": {
        "schemaId": {
          "const": "agent.semantic-protocols.runtime-server-endpoint.v1"
        },
        "schemaVersion": {
          "const": "1"
        },
        "transportContractDigest": {
          "type": "string",
          "minLength": 1
        },
        "ownerEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "runtimeArtifactPath": {
          "type": "string",
          "minLength": 1
        },
        "runtimeArtifactDigest": {
          "type": "string",
          "minLength": 1
        },
        "bindingToken": {
          "type": "string",
          "minLength": 1
        },
        "socketPath": {
          "type": "string",
          "minLength": 1
        },
        "statusMemoryPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "statusSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "generation",
        "state",
        "runtimeArtifactDigest",
        "transportContractDigest",
        "workspaceEntryCount",
        "ownerEpoch"
      ],
      "properties": {
        "schemaId": {
          "const": "agent.semantic-protocols.runtime-server-status-snapshot.v1"
        },
        "schemaVersion": {
          "const": "1"
        },
        "generation": {
          "type": "integer",
          "minimum": 2
        },
        "state": {
          "enum": [
            "healthy",
            "starting",
            "draining",
            "degraded"
          ]
        },
        "runtimeArtifactDigest": {
          "type": "string",
          "minLength": 1
        },
        "transportContractDigest": {
          "type": "string",
          "minLength": 1
        },
        "workspaceEntryCount": {
          "type": "integer",
          "minimum": 0
        },
        "ownerEpoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requestBatch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "operation",
        "expectedRuntimeArtifactDigest",
        "requestId",
        "transportContractDigest",
        "ownerEpoch",
        "bindingToken"
      ],
      "properties": {
        "schemaId": {
          "const": "agent.semantic-protocols.runtime-server-control-request.v1"
        },
        "schemaVersion": {
          "const": "1"
        },
        "operation": {
          "enum": [
            "status",
            "reconcile",
            "restart"
          ]
        },
        "expectedRuntimeArtifactDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transportContractDigest": {
          "type": "string",
          "pattern": "^blake3-256:[0-9a-f]{64}$"
        },
        "ownerEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "bindingToken": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "receiptBatch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "requestId",
        "state",
        "runtimeArtifactDigest",
        "transportContractDigest",
        "workspaceEntryCount"
      ],
      "properties": {
        "schemaId": {
          "const": "agent.semantic-protocols.runtime-server-control-receipt.v1"
        },
        "schemaVersion": {
          "const": "1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "healthy",
            "starting",
            "draining",
            "degraded"
          ]
        },
        "runtimeArtifactDigest": {
          "type": "string",
          "minLength": 1
        },
        "transportContractDigest": {
          "type": "string",
          "minLength": 1
        },
        "workspaceEntryCount": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
