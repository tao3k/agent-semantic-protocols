{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/semantic-proof-receipt.v1.schema.json",
  "title": "Semantic Proof Receipt v1",
  "description": "Compact formal-verification receipt that can update DynamicTopology branch legality without exposing full proof text to the agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "protocolId",
    "protocolVersion",
    "receiptId",
    "obligationId",
    "recipeId",
    "checker",
    "environment",
    "okay",
    "trustLevel",
    "failedDeclarations",
    "formalStatementDigest",
    "candidateDigest",
    "timings",
    "schemaProjection",
    "packetProjection",
    "validatedClaims",
    "defensiveEngineeringAssessment",
    "branchLegalityUpdate",
    "summaryForAgent"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.semantic-proof-receipt"
    },
    "schemaVersion": {
      "const": "1"
    },
    "protocolId": {
      "const": "agent.semantic-protocols.formal-verification"
    },
    "protocolVersion": {
      "const": "1"
    },
    "receiptId": {
      "$ref": "#/$defs/id"
    },
    "obligationId": {
      "$ref": "#/$defs/id"
    },
    "recipeId": {
      "$ref": "#/$defs/id"
    },
    "checker": {
      "enum": ["axle.verify_proof", "axle.check", "lean", "custom"]
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "okay": {
      "type": "boolean"
    },
    "trustLevel": {
      "enum": ["compile", "axiom-audited", "verify-proof", "external-checker", "untrusted"]
    },
    "failedDeclarations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "formalStatementDigest": {
      "$ref": "#/$defs/digest"
    },
    "candidateDigest": {
      "$ref": "#/$defs/digest"
    },
    "timings": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "schemaProjection": {
      "$ref": "semantic-proof-definitions.v1.schema.json#/$defs/schemaProjection"
    },
    "packetProjection": {
      "$ref": "semantic-proof-definitions.v1.schema.json#/$defs/packetProjection"
    },
    "validatedClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "semantic-proof-definitions.v1.schema.json#/$defs/validatedClaim"
      }
    },
    "defensiveEngineeringAssessment": {
      "$ref": "semantic-proof-definitions.v1.schema.json#/$defs/defensiveEngineeringAssessment"
    },
    "branchLegalityUpdate": {
      "$ref": "#/$defs/branchLegalityUpdate"
    },
    "summaryForAgent": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "$ref": "#/$defs/fields"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "integer" },
        { "type": "boolean" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "integer" },
              { "type": "boolean" }
            ]
          }
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "branchLegalityUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["illegal", "legal"],
      "properties": {
        "illegal": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "legal": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
