{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/search-data-composition-receipt.v1.schema.json",
  "title": "Internal POO to MRR Data Search composition receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "pooDagDigest",
    "pooFactorIds",
    "pooEdges",
    "scope",
    "generationIdentity",
    "sourceDigest",
    "residentViewDigest",
    "compositionAbiDigest",
    "mode",
    "branchCount",
    "mergedOwnerCount",
    "observationCount",
    "nativeReasoningDigest",
    "compositionIdentity",
    "branchCompleteness",
    "mergedOwnerIds",
    "mergedOwnerIdsTruncated"
  ],
  "properties": {
    "pooDagDigest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "pooFactorIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pooEdges": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "uniqueItems": true
    },
    "schemaId": {
      "const": "agent.semantic-protocols.search-data-composition-receipt"
    },
    "schemaVersion": {
      "const": "1"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "generationIdentity": {
      "type": "string",
      "pattern": "^mrr:generation:v1:[0-9a-f]{64}$"
    },
    "sourceDigest": {
      "type": "string",
      "minLength": 1
    },
    "residentViewDigest": {
      "type": "string",
      "minLength": 1
    },
    "compositionAbiDigest": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "single",
        "rankJoin",
        "intersect"
      ]
    },
    "branchCount": {
      "type": "integer",
      "minimum": 1
    },
    "mergedOwnerCount": {
      "type": "integer",
      "minimum": 0
    },
    "observationCount": {
      "type": "integer",
      "minimum": 0
    },
    "nativeReasoningDigest": {
      "type": "string",
      "minLength": 1
    },
    "compositionIdentity": {
      "type": "string",
      "minLength": 1
    },
    "branchCompleteness": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "boolean"
          },
          {
            "type": "boolean"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "mergedOwnerIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mergedOwnerIdsTruncated": {
      "type": "boolean"
    }
  }
}
