{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/workspace-generation-required.schema.json",
  "title": "Workspace Generation Required",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "state",
    "reasonKind",
    "admissionTrigger",
    "buildOwner",
    "requestLifetimeIndependent",
    "retryPolicy",
    "argv",
    "nextAction",
    "cause"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.workspace-generation-required"
    },
    "schemaVersion": { "const": "1" },
    "state": { "const": "in-progress" },
    "reasonKind": { "const": "active-workspace-generation-required" },
    "admissionTrigger": { "const": "query-demand" },
    "buildOwner": { "const": "runtime-server" },
    "requestLifetimeIndependent": { "const": true },
    "retryPolicy": { "const": "retry-after-runtime-progress" },
    "argv": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "nextAction": { "type": "string", "minLength": 1 },
    "cause": { "type": "string", "minLength": 1 }
  }
}
