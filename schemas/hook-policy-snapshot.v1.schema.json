{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/hook-policy-snapshot.v1.schema.json",
  "title": "ASP Hook Policy Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "kernelVersion",
    "sourceDigest",
    "compilerDigest",
    "providerRegistryDigest",
    "merkleRoot",
    "languageProviders",
    "rules",
    "fallbackPolicy",
    "synchronousDependencies"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.hook-policy-snapshot"
    },
    "schemaVersion": {
      "const": "1"
    },
    "kernelVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceDigest": {
      "$ref": "#/$defs/digest"
    },
    "compilerDigest": {
      "$ref": "#/$defs/digest"
    },
    "providerRegistryDigest": {
      "$ref": "#/$defs/digest"
    },
    "merkleRoot": {
      "$ref": "#/$defs/digest"
    },
    "languageProviders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/languageProvider"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "fallbackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceEffect",
        "unknownSourceLikeEffect",
        "provedNoSourceEffect"
      ],
      "properties": {
        "sourceEffect": {
          "const": "deny"
        },
        "unknownSourceLikeEffect": {
          "const": "deny"
        },
        "provedNoSourceEffect": {
          "const": "allow"
        }
      }
    },
    "synchronousDependencies": {
      "description": "The enforcement kernel admits no control-plane dependency.",
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "languageProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageId",
        "providerId",
        "extensions"
      ],
      "properties": {
        "languageId": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9._+-]*$"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "priority",
        "decision",
        "reasonKind"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "enum": [
            "allow",
            "deny",
            "block"
          ]
        },
        "reasonKind": {
          "type": "string",
          "minLength": 1
        },
        "actionAny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "effectAny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "authorityAny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "subjectKindAny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
