{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-state-cleanup-plan.v1.schema.json",
  "title": "Runtime State Cleanup Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "state",
    "planDigest",
    "expectedActiveBundleDigest",
    "expectedHealthyBundleDigest",
    "entries"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-state-cleanup-plan"
    },
    "schemaVersion": {
      "const": "1"
    },
    "state": {
      "enum": ["planned", "committed", "rejected", "cancelled"]
    },
    "planDigest": {
      "$ref": "./common.schema.json#/$defs/blake3Digest"
    },
    "expectedActiveBundleDigest": {
      "oneOf": [
        { "$ref": "./common.schema.json#/$defs/blake3Digest" },
        { "type": "null" }
      ]
    },
    "expectedHealthyBundleDigest": {
      "oneOf": [
        { "$ref": "./common.schema.json#/$defs/blake3Digest" },
        { "type": "null" }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "reasonKind", "evidenceClass"],
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "reasonKind": {
            "enum": [
              "legacy-runtime-authority",
              "unreachable-content",
              "expired-diagnostic",
              "abandoned-stage"
            ]
          },
          "evidenceClass": {
            "enum": [
              "active-healthy-unreachable",
              "lease-unreachable",
              "handoff-unreachable",
              "retention-expired"
            ]
          }
        }
      }
    }
  }
}
