{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/agent-session-namespace-projection.v1.schema.json",
  "title": "Agent Session Namespace Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "projectId",
    "workspaceId",
    "canonicalWorkspaceRoot",
    "sessionIdentity",
    "rootNamespaceId",
    "agentName",
    "generation",
    "namespaceState",
    "namespaceAction",
    "hostLiveness",
    "decision",
    "hostAction"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.agent-session-namespace-projection"
    },
    "schemaVersion": {
      "const": "1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "canonicalWorkspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "sessionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "platformSessionId", "sessionIdentityAuthority"],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "platformSessionId": {
          "type": "string",
          "minLength": 1
        },
        "sessionIdentityAuthority": {
          "const": "platform-environment"
        }
      }
    },
    "rootNamespaceId": {
      "type": "string",
      "minLength": 1
    },
    "agentName": {
      "type": "string",
      "pattern": "^@[a-z][a-z0-9_-]*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "namespaceState": {
      "enum": ["absent", "present"]
    },
    "namespaceAction": {
      "enum": ["create", "resume"]
    },
    "hostLiveness": {
      "enum": ["running", "idle", "terminated"]
    },
    "decision": {
      "enum": ["create-new", "continue-existing"]
    },
    "hostAction": {
      "enum": ["spawn_agent", "followup_task"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "namespaceState": { "const": "absent" }
        },
        "required": ["namespaceState"]
      },
      "then": {
        "properties": {
          "namespaceAction": { "const": "create" },
          "decision": { "const": "create-new" },
          "hostAction": { "const": "spawn_agent" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "namespaceState": { "const": "present" }
        },
        "required": ["namespaceState"]
      },
      "then": {
        "properties": {
          "namespaceAction": { "const": "resume" },
          "decision": { "const": "continue-existing" },
          "hostAction": { "const": "followup_task" }
        }
      }
    }
  ]
}
