{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/agent-org-topology-overlay.v1.schema.json",
  "title": "Agent Org Topology Overlay V1",
  "description": "Content-bound Agent summary and Org AST overlay that cannot mutate the base Search topology identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "sourceGenerationDigest",
    "baseTopologyGenerationDigest", "selector", "evidenceDigest", "agentIdentityDigest",
    "promptDigest", "summary", "summaryDigest", "orgSource",
    "orgSourceDigest", "orgAstDigest", "overlayDigest", "relationships", "terminal"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.agent-org-topology-overlay"},
    "schemaVersion": {"const": "1"},
    "sourceGenerationDigest": {"$ref": "#/$defs/digest"},
    "baseTopologyGenerationDigest": {"$ref": "#/$defs/digest"},
    "selector": {"type": "string", "minLength": 1},
    "evidenceDigest": {"$ref": "#/$defs/digest"},
    "agentIdentityDigest": {"$ref": "#/$defs/digest"},
    "promptDigest": {"$ref": "#/$defs/digest"},
    "summary": {"type": "string", "minLength": 1},
    "summaryDigest": {"$ref": "#/$defs/digest"},
    "orgSource": {"type": "string", "minLength": 1},
    "orgSourceDigest": {"$ref": "#/$defs/digest"},
    "orgAstDigest": {"$ref": "#/$defs/digest"},
    "overlayDigest": {"$ref": "#/$defs/digest"},
    "relationships": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relationship"}
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "terminalCount", "reasonKind"],
      "properties": {
        "state": {"const": "admitted"},
        "terminalCount": {"const": 1},
        "reasonKind": {"type": "null"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"},
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromSelector", "relation", "toSelector"],
      "properties": {
        "fromSelector": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "toSelector": {"type": "string", "minLength": 1}
      }
    }
  }
}
