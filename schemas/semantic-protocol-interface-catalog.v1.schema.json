{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/semantic-protocol-interface-catalog.v1.schema.json",
  "title": "ASP Protocol Interface Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "catalogDigest", "interfaces"],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.protocol-interface-catalog"
    },
    "schemaVersion": {
      "const": "1"
    },
    "catalogDigest": {
      "$ref": "#/$defs/digest"
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interface"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[0-9a-f]{64}$"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interfaceId",
        "interfaceVersion",
        "capabilityId",
        "requestSchemaDigest",
        "responseSchemaDigest"
      ],
      "properties": {
        "interfaceId": {
          "type": "string",
          "minLength": 1
        },
        "interfaceVersion": {
          "type": "string",
          "minLength": 1
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "requestSchemaDigest": {
          "$ref": "#/$defs/digest"
        },
        "responseSchemaDigest": {
          "$ref": "#/$defs/digest"
        },
        "identitySchemaDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportContractDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
