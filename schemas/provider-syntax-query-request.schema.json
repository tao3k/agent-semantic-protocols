{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-syntax-query-request.schema.json",
  "title": "Provider Syntax Query Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "languageId", "providerId", "ownerPath", "sourceContentDigest", "queryDigest", "source", "plan"],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.provider-syntax-query-request" },
    "schemaVersion": { "const": "1" },
    "languageId": { "type": "string", "minLength": 1 },
    "providerId": { "type": "string", "minLength": 1 },
    "ownerPath": { "type": "string", "minLength": 1 },
    "sourceContentDigest": { "$ref": "#/$defs/digest" },
    "queryDigest": { "$ref": "#/$defs/digest" },
    "source": { "type": "string" },
    "plan": { "$ref": "#/$defs/plan" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "pattern": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "captures", "nodeTypes", "fields"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "captures": { "$ref": "#/$defs/strings" },
        "nodeTypes": { "$ref": "#/$defs/strings" },
        "fields": { "$ref": "#/$defs/strings" }
      }
    },
    "predicateValue": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["string", "capture"] },
        "value": { "type": "string" }
      }
    },
    "predicate": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "capture", "values"],
      "properties": {
        "op": { "enum": ["eq", "any-eq", "any-of", "match", "any-match", "not-eq", "not-match"] },
        "capture": { "type": "string", "minLength": 1 },
        "values": { "type": "array", "items": { "$ref": "#/$defs/predicateValue" } }
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["patterns", "captures", "nodeTypes", "fields", "predicates"],
      "properties": {
        "patterns": { "type": "array", "items": { "$ref": "#/$defs/pattern" }, "minItems": 1 },
        "captures": { "$ref": "#/$defs/strings" },
        "nodeTypes": { "$ref": "#/$defs/strings" },
        "fields": { "$ref": "#/$defs/strings" },
        "predicates": { "type": "array", "items": { "$ref": "#/$defs/predicate" } }
      }
    }
  }
}
