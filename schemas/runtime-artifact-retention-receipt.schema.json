{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-artifact-retention-receipt.schema.json",
  "title": "Runtime Artifact Retention Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "contentAlgorithm",
    "retentionPolicy",
    "retainedSlotsPerBinary",
    "scannedGenerationCount",
    "retainedGenerationCount",
    "removedGenerationCount",
    "ignoredEntryCount",
    "reclaimedBytes",
    "protectedDigests"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-artifact-retention-receipt"
    },
    "schemaVersion": { "const": "1" },
    "contentAlgorithm": { "const": "blake3-256" },
    "retentionPolicy": { "const": "active-healthy-reachability" },
    "retainedSlotsPerBinary": { "const": 2 },
    "scannedGenerationCount": { "type": "integer", "minimum": 0 },
    "retainedGenerationCount": { "type": "integer", "minimum": 0 },
    "removedGenerationCount": { "type": "integer", "minimum": 0 },
    "scannedCandidateCount": { "type": "integer", "minimum": 0 },
    "retainedCandidateCount": { "type": "integer", "minimum": 0 },
    "removedCandidateCount": { "type": "integer", "minimum": 0 },
    "retiredSupersededStoreCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Number of pre-generation physical store roots atomically retired after a canonical active or healthy generation was admitted."
    },
    "retiredSupersededLeaseDirectoryCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of binary-namespaced candidate lease directories retired after generation-keyed leases became authoritative."
    },
    "retiredMisplacedLauncherRootCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "Whether a State Home bin directory containing only managed links into the active Runtime generation was retired."
    },
    "retiredSupersededProviderStagingRootCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "Whether the superseded runtime/providers staging root was atomically retired after Artifacts staging became authoritative."
    },
    "ignoredEntryCount": { "type": "integer", "minimum": 0 },
    "reclaimedBytes": { "type": "integer", "minimum": 0 },
    "protectedDigests": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "uniqueItems": true
    }
  }
}
