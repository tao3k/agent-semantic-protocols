{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/codex-collaboration-interrupt-result.v1.schema.json",
  "title": "Codex Collaboration Interrupt Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["previous_status"],
  "properties": {
    "previous_status": { "$ref": "#/$defs/agentStatus" }
  },
  "$defs": {
    "agentStatus": {
      "oneOf": [
        {
          "enum": [
            "pending_init",
            "running",
            "interrupted",
            "shutdown",
            "not_found"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed"],
          "properties": {
            "completed": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["errored"],
          "properties": {
            "errored": { "type": "string" }
          }
        }
      ]
    }
  }
}
