{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/exact-selector-materialization-proof.v1.schema.json",
  "title": "Exact Selector Materialization Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "projectionPacket",
    "merkleProof",
    "sourceByteStart",
    "sourceByteEnd"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.exact-selector-materialization-proof"
    },
    "schemaVersion": {
      "const": "1"
    },
    "projectionPacket": {
      "$ref": "https://agent-semantic-protocols.dev/schemas/exact-selector-projection-packet.v1.schema.json"
    },
    "merkleProof": {
      "$ref": "https://agent-semantic-protocols.dev/schemas/exact-selector-merkle-proof.v1.schema.json"
    },
    "sourceByteStart": {
      "type": "integer",
      "minimum": 0
    },
    "sourceByteEnd": {
      "type": "integer",
      "minimum": 1
    }
  }
}
