{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.semantic.protocols/schemas/state-home-project-binding",
  "title": "ASP State Home Project Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "hostProject", "repo", "workspace", "bindingDigest"],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.state-home-project-binding" },
    "schemaVersion": { "const": 1 },
    "hostProject": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "projectId", "projectKind", "hostId"],
          "properties": {
            "platform": { "type": "string", "minLength": 1 },
            "projectId": { "type": "string", "minLength": 1 },
            "projectKind": { "type": "string", "minLength": 1 },
            "hostId": { "type": ["string", "null"], "minLength": 1 }
          }
        }
      ]
    },
    "repo": { "$ref": "#/$defs/repoIdentity" },
    "workspace": { "$ref": "#/$defs/workspaceIdentity" },
    "bindingDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "repoIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "basis"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "workspaceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "repoDigest", "canonicalRoot", "privateGitDir"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "repoDigest": { "$ref": "#/$defs/digest" },
        "canonicalRoot": { "type": "string", "minLength": 1 },
        "privateGitDir": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Canonical gix worktree-private Git directory. Null is reserved for imported non-Git observations."
        }
      }
    }
  }
}
