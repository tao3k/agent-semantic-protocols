{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-server-lifecycle-receipt.v1.schema.json",
  "title": "Provider Server Lifecycle Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "languageId", "providerId", "state",
    "attempt", "publicationEpoch", "artifactDigest", "manifestDigest",
    "runtimeContractDigest", "operations"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.provider-server-lifecycle-receipt" },
    "schemaVersion": { "const": "1" },
    "languageId": { "type": "string", "minLength": 1 },
    "providerId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["declared", "starting", "warming", "ready", "draining", "stopped", "failed"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "publicationEpoch": { "type": "integer", "minimum": 0 },
    "artifactDigest": { "type": "string", "minLength": 1 },
    "manifestDigest": { "type": "string", "minLength": 1 },
    "runtimeContractDigest": { "type": "string", "minLength": 1 },
    "endpoint": { "type": ["string", "null"] },
    "operations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "error": { "type": ["string", "null"] }
  }
}
