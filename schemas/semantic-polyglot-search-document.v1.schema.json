{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/semantic-polyglot-search-document.v1.schema.json",
  "title": "Semantic Polyglot Search Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "sourceSnapshot",
    "provider",
    "control",
    "sections"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.polyglot-search-document.v1"
    },
    "schemaVersion": { "const": "1" },
    "sourceSnapshot": { "$ref": "#/$defs/sourceSnapshot" },
    "provider": { "$ref": "#/$defs/provider" },
    "control": { "$ref": "#/$defs/control" },
    "sections": { "$ref": "#/$defs/sections" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[a-f0-9]{64}$"
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootDigest", "algorithm", "dirtyPathsDigest"],
      "properties": {
        "rootDigest": { "$ref": "#/$defs/digest" },
        "algorithm": { "enum": ["blake3-256", "sha256"] },
        "dirtyPathsDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languageId", "providerId", "artifactDigest"],
      "properties": {
        "languageId": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotRef",
        "exposureBudget",
        "selectionBudget",
        "graphHopBudget",
        "roundBudget",
        "projectedTokenBudget",
        "emit"
      ],
      "properties": {
        "snapshotRef": { "type": "string", "minLength": 1 },
        "continuationRef": { "type": "string", "minLength": 1 },
        "exposureBudget": { "type": "integer", "minimum": 1, "maximum": 10 },
        "selectionBudget": { "type": "integer", "minimum": 1, "maximum": 3 },
        "graphHopBudget": { "type": "integer", "minimum": 1 },
        "roundBudget": { "type": "integer", "minimum": 1 },
        "projectedTokenBudget": { "type": "integer", "minimum": 1 },
        "emit": { "enum": ["frontier", "evidence", "closure"] }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "gql": { "$ref": "#/$defs/gql" },
        "logic": { "$ref": "#/$defs/logic" },
        "turbo": { "$ref": "#/$defs/turbo" }
      }
    },
    "gql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "source", "clauses"],
      "properties": {
        "profile": { "const": "asp-gql-core:0.1" },
        "source": { "type": "string", "minLength": 1 },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["match", "where", "return", "bounded-path"]
          }
        }
      }
    },
    "logic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "source", "forms", "rulesetDigest"],
      "properties": {
        "profile": { "const": "asp-logic-query-core:0.1" },
        "source": { "type": "string", "minLength": 1 },
        "forms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["query-goal", "conjunction", "registered-predicate", "safe-negation"]
          }
        },
        "rulesetDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "turbo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileDigest"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "profileDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
