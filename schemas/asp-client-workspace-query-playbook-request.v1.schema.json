{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/asp-client-workspace-query-playbook-request.v1.schema.json",
  "title": "ASP Client Workspace Query Playbook Request V1",
  "description": "One language-neutral northbound Query Playbook request. Runtime injects workspace and execution identity after transport admission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "selectors", "projection"],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.asp-client-workspace-query-playbook-request"},
    "schemaVersion": {"const": "1"},
    "selectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9+.-]*://[^\\s#]+#item/.+$(?![\\s\\S])"
      }
    },
    "projection": {"enum": ["source", "callable-skeleton"]}
  }
}
