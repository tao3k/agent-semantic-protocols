{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/axle-lean-audit-receipt.v1.schema.json",
  "title": "AXLE Lean audit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "auditSha256",
    "declarationCount",
    "axiomFreeDeclarationCount",
    "axiomDependentDeclarationCount",
    "theoremFamilies",
    "rfcClauseIds",
    "axiomInventory"
  ],
  "properties": {
    "schemaId": {
      "const": "asp.axle-lean-audit-receipt.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "auditSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declarationCount": {
      "type": "integer",
      "minimum": 1
    },
    "axiomFreeDeclarationCount": {
      "type": "integer",
      "minimum": 0
    },
    "axiomDependentDeclarationCount": {
      "type": "integer",
      "minimum": 0
    },
    "theoremFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rfcClauseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ASP-RFC-"
      }
    },
    "axiomInventory": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
