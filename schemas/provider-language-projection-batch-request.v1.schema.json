{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-language-projection-batch-request.v1.schema.json",
  "title": "Provider Language Projection Batch Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "languageId",
    "providerId",
    "workspaceIdentity",
    "generationRootDigest",
    "transport",
    "owners"
  ],
  "properties": {
    "schemaId": {
      "const": "asp.provider-language-projection-batch-request.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1
    },
    "generationRootDigest": {
      "type": "string",
      "minLength": 32
    },
    "baseGenerationRootDigest": {
      "type": "string",
      "minLength": 32
    },
    "transport": {
      "const": "framed-stdin-v1"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ownerPath", "sourceLeafDigest", "byteLength"],
        "properties": {
          "ownerPath": {
            "type": "string",
            "minLength": 1
          },
          "sourceLeafDigest": {
            "type": "string",
            "minLength": 32
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
