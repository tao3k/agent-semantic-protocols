{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.github.io/agent-semantic-protocols/schemas/agent-route-registry.v1.schema.json",
  "title": "Agent Route Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "agents"],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.agent-route-registry"
    },
    "schemaVersion": {
      "const": "1"
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/agentRoute" }
    }
  },
  "$defs": {
    "agentRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionName", "sessionLifetime", "roles", "platforms"],
      "properties": {
        "sessionName": { "type": "string", "minLength": 1 },
        "sessionLifetime": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "platforms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/platformRoute" }
        }
      }
    },
    "platformRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection"],
      "properties": {
        "projection": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        }
      }
    }
  }
}
