{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/search-route-proposal-set.v1.schema.json",
  "title": "Search Route Proposal Set v1",
  "oneOf": [
    {
      "$ref": "#/$defs/readyProposalSet"
    },
    {
      "$ref": "#/$defs/blockedProposalSet"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "$ref": "context-product-state.v1.schema.json#/$defs/digest"
    },
    "base": {
      "type": "object",
      "required": [
        "schemaId",
        "schemaVersion",
        "proposalSetId",
        "runId",
        "basedOnRevision",
        "contextBindingDigest",
        "intentDigest",
        "catalogDigest",
        "plannerBackendId",
        "plannerBackendDigest",
        "state",
        "setDigest"
      ],
      "properties": {
        "schemaId": {
          "const": "agent.semantic-protocols.search-route-proposal-set"
        },
        "schemaVersion": {
          "const": "1"
        },
        "proposalSetId": {
          "$ref": "#/$defs/id"
        },
        "runId": {
          "$ref": "#/$defs/id"
        },
        "basedOnRevision": {
          "type": "integer",
          "minimum": 0
        },
        "contextBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "intentDigest": {
          "$ref": "#/$defs/digest"
        },
        "catalogDigest": {
          "$ref": "#/$defs/digest"
        },
        "plannerBackendId": {
          "$ref": "#/$defs/id"
        },
        "plannerBackendDigest": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "setDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "readyProposalSet": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaId",
            "schemaVersion",
            "proposalSetId",
            "runId",
            "basedOnRevision",
            "contextBindingDigest",
            "intentDigest",
            "catalogDigest",
            "plannerBackendId",
            "plannerBackendDigest",
            "state",
            "proposals",
            "setDigest"
          ],
          "properties": {
            "schemaId": {
              "const": "agent.semantic-protocols.search-route-proposal-set"
            },
            "schemaVersion": {
              "const": "1"
            },
            "proposalSetId": {
              "$ref": "#/$defs/id"
            },
            "runId": {
              "$ref": "#/$defs/id"
            },
            "basedOnRevision": {
              "type": "integer",
              "minimum": 0
            },
            "contextBindingDigest": {
              "$ref": "#/$defs/digest"
            },
            "intentDigest": {
              "$ref": "#/$defs/digest"
            },
            "catalogDigest": {
              "$ref": "#/$defs/digest"
            },
            "plannerBackendId": {
              "$ref": "#/$defs/id"
            },
            "plannerBackendDigest": {
              "$ref": "#/$defs/digest"
            },
            "state": {
              "const": "ready"
            },
            "proposals": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "context-product-state.v1.schema.json#/$defs/routeProposal"
              }
            },
            "recommendedProposalId": {
              "$ref": "#/$defs/id"
            },
            "setDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "blockedProposalSet": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaId",
            "schemaVersion",
            "proposalSetId",
            "runId",
            "basedOnRevision",
            "contextBindingDigest",
            "intentDigest",
            "catalogDigest",
            "plannerBackendId",
            "plannerBackendDigest",
            "state",
            "blocker",
            "setDigest"
          ],
          "properties": {
            "schemaId": {
              "const": "agent.semantic-protocols.search-route-proposal-set"
            },
            "schemaVersion": {
              "const": "1"
            },
            "proposalSetId": {
              "$ref": "#/$defs/id"
            },
            "runId": {
              "$ref": "#/$defs/id"
            },
            "basedOnRevision": {
              "type": "integer",
              "minimum": 0
            },
            "contextBindingDigest": {
              "$ref": "#/$defs/digest"
            },
            "intentDigest": {
              "$ref": "#/$defs/digest"
            },
            "catalogDigest": {
              "$ref": "#/$defs/digest"
            },
            "plannerBackendId": {
              "$ref": "#/$defs/id"
            },
            "plannerBackendDigest": {
              "$ref": "#/$defs/digest"
            },
            "state": {
              "const": "blocked"
            },
            "blocker": {
              "$ref": "#/$defs/blocker"
            },
            "setDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasonKind",
        "detail"
      ],
      "properties": {
        "reasonKind": {
          "enum": [
            "provider-unavailable",
            "state-unavailable",
            "catalog-unavailable",
            "context-stale",
            "budget-infeasible",
            "no-coverage-gain"
          ]
        },
        "providerId": {
          "$ref": "#/$defs/id"
        },
        "capabilityRef": {
          "$ref": "#/$defs/id"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
