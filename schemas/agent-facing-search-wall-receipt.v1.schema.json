{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/agent-facing-search-wall-receipt.v1.schema.json",
  "title": "Agent-facing ASP search wall-time receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "surface",
    "languageId",
    "commandDigest",
    "timingScope",
    "wallTimeMicros",
    "budgetMicros",
    "budgetStatus",
    "replyKind"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.agent-facing-search-wall-receipt"
    },
    "schemaVersion": {
      "const": "1"
    },
    "surface": {
      "enum": ["query", "search"]
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timingScope": {
      "const": "agent-facing-end-to-end"
    },
    "wallTimeMicros": {
      "type": "integer",
      "minimum": 0
    },
    "budgetMicros": {
      "const": 1000000
    },
    "budgetStatus": {
      "enum": ["within-budget", "budget-exceeded"]
    },
    "replyKind": {
      "enum": ["evidence", "progress", "unavailable", "failure", "no-reply"]
    },
    "exitCode": {
      "type": "integer"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "budgetStatus": {
            "const": "within-budget"
          }
        },
        "required": ["budgetStatus"]
      },
      "then": {
        "properties": {
          "wallTimeMicros": {
            "maximum": 999999
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "budgetStatus": {
            "const": "budget-exceeded"
          }
        },
        "required": ["budgetStatus"]
      },
      "then": {
        "properties": {
          "wallTimeMicros": {
            "minimum": 1000000
          }
        }
      }
    }
  ]
}
