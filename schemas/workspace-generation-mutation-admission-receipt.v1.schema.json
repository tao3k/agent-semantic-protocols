{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/workspace-generation-mutation-admission-receipt.v1.schema.json",
  "title": "Workspace Generation Mutation Admission Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "mutationId",
    "changedPathCount",
    "affectedWorkspaceCount",
    "receipts"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.workspace-generation-mutation-admission-receipt"
    },
    "schemaVersion": {
      "const": "1"
    },
    "mutationId": {
      "type": "string",
      "minLength": 1
    },
    "changedPathCount": {
      "type": "integer",
      "minimum": 1
    },
    "affectedWorkspaceCount": {
      "type": "integer",
      "minimum": 1
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaId",
          "schemaVersion",
          "workspaceIdentity",
          "state",
          "accepted",
          "attempt"
        ],
        "properties": {
          "schemaId": {
            "const": "agent.semantic-protocols.runtime-server-workspace-generation-admission.v1"
          },
          "schemaVersion": {
            "const": "1"
          },
          "workspaceIdentity": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "building",
              "ready",
              "failed"
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
