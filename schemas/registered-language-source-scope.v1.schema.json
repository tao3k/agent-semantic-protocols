{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/registered-language-source-scope.v1.schema.json",
  "title": "Registered Language Source Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "languageId",
    "providerId",
    "targetRootAuthority",
    "defaultTargetRoots",
    "sourceExtensions"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.registered-language-source-scope"
    },
    "schemaVersion": {
      "const": "1"
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "targetRootAuthority": {
      "enum": [
        "package-manager",
        "provider-schema"
      ]
    },
    "defaultTargetRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "sourceExtensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9._+-]*$"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
