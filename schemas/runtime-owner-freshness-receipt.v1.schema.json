{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/runtime-owner-freshness-receipt.v1.schema.json",
  "title": "Runtime Owner Freshness Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "workspaceIdentity",
    "generationDigest",
    "ownerPath",
    "ownerContentDigest",
    "changed",
    "removed"
  ],
  "properties": {
    "schemaId": {
      "const": "asp.runtime-owner-freshness-receipt.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1
    },
    "generationDigest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "ownerPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "ownerContentDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^blake3-256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "removed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "removed": {
            "const": true
          }
        },
        "required": [
          "removed"
        ]
      },
      "then": {
        "properties": {
          "ownerContentDigest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "ownerContentDigest": {
            "type": "string",
            "pattern": "^blake3-256:[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
