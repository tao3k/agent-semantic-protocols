{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-semantic-protocols:schema:asp-cli-failure",
  "title": "ASP CLI Failure",
  "x-asp-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "state",
    "reasonKind",
    "failureLayer",
    "message",
    "originalError"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.cli-failure" },
    "schemaVersion": { "const": 1 },
    "state": { "const": "blocked" },
    "reasonKind": {
      "enum": [
        "host-operation-not-permitted",
        "transport-unavailable",
        "runtime-status-observation-failed"
      ]
    },
    "failureLayer": {
      "enum": [
        "asp-cli-startup-or-ipc-boundary",
        "runtime-verified-endpoint-transport",
        "runtime-transport-capability",
        "runtime-status-observation"
      ]
    },
    "message": { "type": "string", "minLength": 1 },
    "osError": { "type": "string", "minLength": 1 },
    "recovery": { "type": "string", "minLength": 1 },
    "originalError": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    {
      "properties": {
        "reasonKind": { "const": "host-operation-not-permitted" },
        "failureLayer": {
          "enum": [
            "asp-cli-startup-or-ipc-boundary",
            "runtime-verified-endpoint-transport"
          ]
        },
        "osError": { "const": "EPERM" },
        "recovery": { "type": "string", "minLength": 1 }
      },
      "required": ["osError", "recovery"]
    },
    {
      "properties": {
        "reasonKind": { "const": "transport-unavailable" },
        "failureLayer": { "const": "runtime-transport-capability" }
      }
    },
    {
      "properties": {
        "reasonKind": { "const": "runtime-status-observation-failed" },
        "failureLayer": { "const": "runtime-status-observation" }
      }
    }
  ]
}
