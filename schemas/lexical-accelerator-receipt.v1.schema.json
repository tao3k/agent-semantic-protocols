{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/lexical-accelerator-receipt.v1.schema.json",
  "title": "Lexical accelerator receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "identity", "contentGenerationDigest", "lexicalPlanDigest",
    "tantivyArtifactDigest", "equivalenceCases", "equivalenceDigest", "complete"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.lexical-accelerator-receipt"},
    "schemaVersion": {"const": "1"},
    "identity": {"$ref": "https://schemas.agent-semantic-protocols.dev/semantic-search-definitions.v1.schema.json#/$defs/generationIdentity"},
    "contentGenerationDigest": {"$ref": "#/$defs/digest"},
    "lexicalPlanDigest": {"$ref": "#/$defs/digest"},
    "tantivyArtifactDigest": {"$ref": "#/$defs/digest"},
    "equivalenceCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "normalizedQueryDigest", "coldRgCandidateSetDigest", "tantivyCandidateSetDigest"
        ],
        "properties": {
          "normalizedQueryDigest": {"$ref": "#/$defs/digest"},
          "coldRgCandidateSetDigest": {"$ref": "#/$defs/digest"},
          "tantivyCandidateSetDigest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "equivalenceDigest": {"$ref": "#/$defs/digest"},
    "complete": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"}
  }
}
