{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.dev/schemas/runtime-search-generation-facts.v1.schema.json",
  "title": "Runtime Search Generation Facts v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "generationDigest", "relations"],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-search-generation-facts"
    },
    "schemaVersion": { "const": "1" },
    "generationDigest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "relations": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
