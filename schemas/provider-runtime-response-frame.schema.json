{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-runtime-response-frame.schema.json",
  "title": "ASP Provider Runtime Response Frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "requestId", "outcome"],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.provider-runtime-response-frame" },
    "schemaVersion": { "const": "1" },
    "requestId": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["ready", "error"] },
    "payload": { "type": "object" },
    "error": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    {
      "properties": { "outcome": { "const": "ready" } },
      "required": ["payload"],
      "not": { "required": ["error"] }
    },
    {
      "properties": { "outcome": { "const": "error" } },
      "required": ["error"],
      "not": { "required": ["payload"] }
    }
  ]
}
