{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/search-playbook-pretool-calibration.v2.schema.json",
  "title": "ASP Search Playbook PreTool Calibration V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "state",
    "reasonKind",
    "argumentModel",
    "sourceDigest",
    "expressionArgCount",
    "grammar",
    "layout",
    "issues"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.search-playbook-pretool-calibration"},
    "schemaVersion": {"const": "2"},
    "state": {"const": "rejected"},
    "reasonKind": {"const": "search-playbook-pretool-calibration"},
    "argumentModel": {"const": "one-scheme-expression"},
    "sourceDigest": {
      "type": ["string", "null"],
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "expressionArgCount": {"type": "integer", "minimum": 0},
    "grammar": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/grammarReceipt"}
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "shape", "graphBarrierAfter"],
      "properties": {
        "layoutId": {"const": "rg-tantivy-structural-scope"},
        "shape": {"const": "chain(intersect(rg,tantivy),syntax*,native-syntax*,graph*)"},
        "graphBarrierAfter": {"const": "structural-scope-facts"}
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "grammarReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grammarId",
        "grammarVersion",
        "grammarRepository",
        "byteLength",
        "rootKind",
        "topLevelFormCount",
        "topLevelFormHeads"
      ],
      "properties": {
        "grammarId": {"const": "tree-sitter-scheme"},
        "grammarVersion": {"const": "0.24.7"},
        "grammarRepository": {"const": "https://github.com/6cdh/tree-sitter-scheme"},
        "byteLength": {"type": "integer", "minimum": 1},
        "rootKind": {"type": "string", "minLength": 1},
        "topLevelFormCount": {"type": "integer", "minimum": 1},
        "topLevelFormHeads": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonKind", "field", "message"],
      "properties": {
        "reasonKind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "field": {"const": "expression"},
        "sourceTokenIndex": {"type": "integer", "const": 2},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
