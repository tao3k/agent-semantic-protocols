{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.github.io/agent-semantic-protocols/schemas/asp-schema-reference-decision-registry.v1.schema.json",
  "title": "ASP Schema Reference Decision Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaId": {
      "const": "asp.schema-reference-decision-registry.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "occurrenceSetDigest",
        "familyIds",
        "decision",
        "reviewState",
        "owner",
        "rationale"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "occurrenceSetDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "familyIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision": {
          "enum": [
            "extract-family-definition",
            "promote-parent-definition",
            "intentional-duplication",
            "defer"
          ]
        },
        "reviewState": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "replacementRef": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
