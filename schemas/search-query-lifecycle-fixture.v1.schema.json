{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/search-query-lifecycle-fixture.v1.schema.json",
  "title": "ASP Search Query Lifecycle Fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "caseId",
    "initialState",
    "stimulus",
    "expected"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.search-query-lifecycle-fixture"
    },
    "schemaVersion": {
      "const": "1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceGeneration",
        "providerCatalog",
        "agentSandbox",
        "directRuntimeIpc"
      ],
      "properties": {
        "workspaceGeneration": {
          "enum": ["Missing", "Building", "Ready"]
        },
        "providerCatalog": {
          "enum": ["Missing", "Available"]
        },
        "agentSandbox": {
          "const": "read-only"
        },
        "directRuntimeIpc": {
          "enum": ["available", "permission-denied"]
        }
      }
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postToolMutation", "languageIds", "operations"],
      "properties": {
        "postToolMutation": {
          "type": "boolean"
        },
        "languageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": ["search", "query"]
          },
          "allOf": [
            { "contains": { "const": "search" } },
            { "contains": { "const": "query" } }
          ]
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalWorkspaceGeneration",
        "providerInstallCommands",
        "checkoutWrites",
        "materializationCount",
        "searchProjectionCount",
        "queryProjectionCount",
        "generationAuthority",
        "maxControlReceiptMicros",
        "recommendedNextExecutable"
      ],
      "properties": {
        "terminalWorkspaceGeneration": {
          "const": "Ready"
        },
        "providerInstallCommands": {
          "const": 0
        },
        "checkoutWrites": {
          "const": 0
        },
        "materializationCount": {
          "const": 1
        },
        "searchProjectionCount": {
          "type": "integer",
          "minimum": 1
        },
        "queryProjectionCount": {
          "type": "integer",
          "minimum": 1
        },
        "generationAuthority": {
          "const": "single-ready-publication"
        },
        "maxControlReceiptMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "recommendedNextExecutable": {
          "const": true
        }
      }
    }
  }
}
