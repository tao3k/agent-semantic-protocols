{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent actual POO role order witness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "complete",
    "compositionReceipt",
    "runtimeAlgorithm",
    "roleGraph",
    "roleRoots",
    "runtimeOrders"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.search-order-witness"
    },
    "schemaVersion": {
      "const": "1"
    },
    "complete": {
      "type": "boolean"
    },
    "compositionReceipt": {
      "title": "Internal POO to MRR Data Search composition receipt v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "pooDagDigest",
        "pooFactorIds",
        "pooEdges",
        "scope",
        "generationIdentity",
        "sourceDigest",
        "residentViewDigest",
        "compositionAbiDigest",
        "mode",
        "branchCount",
        "mergedOwnerCount",
        "observationCount",
        "nativeReasoningDigest",
        "compositionIdentity",
        "branchCompleteness",
        "mergedOwnerIds",
        "mergedOwnerIdsTruncated"
      ],
      "properties": {
        "pooDagDigest": {
          "type": "string",
          "pattern": "^blake3-256:[0-9a-f]{64}$"
        },
        "pooFactorIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "pooEdges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "uniqueItems": true
        },
        "schemaId": {
          "const": "agent.semantic-protocols.search-data-composition-receipt"
        },
        "schemaVersion": {
          "const": "1"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "generationIdentity": {
          "type": "string",
          "pattern": "^mrr:generation:v1:[0-9a-f]{64}$"
        },
        "sourceDigest": {
          "type": "string",
          "minLength": 1
        },
        "residentViewDigest": {
          "type": "string",
          "minLength": 1
        },
        "compositionAbiDigest": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "single",
            "rankJoin",
            "intersect"
          ]
        },
        "branchCount": {
          "type": "integer",
          "minimum": 1
        },
        "mergedOwnerCount": {
          "type": "integer",
          "minimum": 0
        },
        "observationCount": {
          "type": "integer",
          "minimum": 0
        },
        "nativeReasoningDigest": {
          "type": "string",
          "minLength": 1
        },
        "compositionIdentity": {
          "type": "string",
          "minLength": 1
        },
        "branchCompleteness": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "boolean"
              },
              {
                "type": "boolean"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "mergedOwnerIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mergedOwnerIdsTruncated": {
          "type": "boolean"
        }
      }
    },
    "runtimeAlgorithm": {
      "const": "gerbil.runtime.c4"
    },
    "roleGraph": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 512,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        ],
        "items": false
      }
    },
    "roleRoots": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 512,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "items": false
      }
    },
    "runtimeOrders": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 512,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        ],
        "items": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "roleGraph": {
            "type": "array",
            "minItems": 1
          },
          "roleRoots": {
            "type": "array",
            "minItems": 1
          },
          "runtimeOrders": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "roleGraph": {
            "type": "null"
          },
          "roleRoots": {
            "type": "null"
          },
          "runtimeOrders": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$id": "https://agent-semantic-protocols.dev/schemas/search-order-witness.v1.schema.json"
}
