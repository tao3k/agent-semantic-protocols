{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-server-stop-receipt.v1.schema.json",
  "title": "ASP Runtime Server Stop Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "requestId",
    "state",
    "lifecycleAuthority",
    "endpointPath",
    "endpointRemoved",
    "controlSocketRemoved",
    "dataPlaneSocketRemoved",
    "statusMemoryRemoved"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-server-stop-receipt.v1"
    },
    "schemaVersion": { "const": "1" },
    "requestId": { "type": "string", "minLength": 1 },
    "state": { "const": "stopped" },
    "lifecycleAuthority": { "const": "platform-supervisor" },
    "endpointPath": { "type": "string", "minLength": 1 },
    "endpointRemoved": { "const": true },
    "controlSocketRemoved": { "const": true },
    "dataPlaneSocketRemoved": { "const": true },
    "statusMemoryRemoved": { "const": true }
  }
}
