{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/provider-native-owner-search-request.v1.schema.json",
  "title": "ASP Provider Native Owner Search Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "languageId",
    "providerId",
    "workspaceIdentity",
    "providerWorkspaceIdentityDigest",
    "ownerPath",
    "sourceFingerprint",
    "sourceEncoding",
    "sourceBytesBase64",
    "query",
    "transport"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.provider-native-owner-search-request"
    },
    "schemaVersion": {
      "const": "1"
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1
    },
    "providerWorkspaceIdentityDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ownerPath": {
      "type": "string",
      "minLength": 1
    },
    "sourceFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileIdentity",
        "sizeBytes",
        "modifiedUnixNanos",
        "changeTimeUnixNanos",
        "contentDigest"
      ],
      "properties": {
        "fileIdentity": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "modifiedUnixNanos": {
          "type": "integer"
        },
        "changeTimeUnixNanos": {
          "type": "integer"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceEncoding": {
      "const": "base64"
    },
    "sourceBytesBase64": {
      "type": "string"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "itemMode"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "itemMode": {
          "enum": [
            "items",
            "signatures"
          ]
        }
      }
    },
    "transport": {
      "const": "stdin-json"
    }
  }
}
