{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/content-search-generation-receipt.v1.schema.json",
  "title": "Content Search Generation Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "acquisition", "contentGenerationDigest"],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.content-search-generation-receipt"},
    "schemaVersion": {"const": "1"},
    "acquisition": {"$ref": "#/$defs/stageReceipt"},
    "contentGenerationDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"},
    "stageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "identity", "artifactDigest", "workerId", "complete"],
      "properties": {
        "stage": {"const": "source-byte-acquisition"},
        "identity": {"$ref": "https://schemas.agent-semantic-protocols.dev/semantic-search-definitions.v1.schema.json#/$defs/generationIdentity"},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "workerId": {"type": "string", "minLength": 1},
        "complete": {"const": true}
      }
    }
  }
}
