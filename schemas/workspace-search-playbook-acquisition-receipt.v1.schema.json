{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/workspace-search-playbook-acquisition-receipt.v1.schema.json",
  "title": "Local Search Playbook Acquisition Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "contentGenerationDigest",
    "ownerCount",
    "fd",
    "rg",
    "tantivy",
    "candidateOwnerPaths",
    "exactSelectors"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.local-search-playbook-acquisition-receipt"
    },
    "schemaVersion": { "const": "1" },
    "contentGenerationDigest": { "$ref": "#/$defs/blake3Digest" },
    "ownerCount": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "fd": { "$ref": "#/$defs/axisReceipt" },
    "rg": { "$ref": "#/$defs/axisReceipt" },
    "tantivy": { "$ref": "#/$defs/axisReceipt" },
    "candidateOwnerPaths": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/ownerPath" }
    },
    "exactSelectors": {
      "description": "Layer One lexical acquisition has no parser selector authority.",
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "blake3Digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "ownerPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
    },
    "axisReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchCandidateOwnerPaths", "candidateOwnerPaths"],
      "properties": {
        "branchCandidateOwnerPaths": {
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 4096,
            "items": { "$ref": "#/$defs/ownerPath" }
          }
        },
        "candidateOwnerPaths": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/ownerPath" }
        }
      }
    }
  }
}
