{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/asp.live-corpus-search-query-qualification-plan.schema.json",
  "title": "ASP Live Corpus Search Query Qualification Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "lockPath",
    "requiredLanguages",
    "clientProtocol",
    "residentSampleCount",
    "sequentialSampleCount",
    "concurrentSampleCount",
    "failureInjections",
    "cacheStates",
    "cases"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.live-corpus-search-query-qualification-plan"
    },
    "schemaVersion": { "const": "1" },
    "lockPath": { "type": "string", "minLength": 1 },
    "requiredLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "clientProtocol": { "$ref": "#/$defs/clientProtocolContract" },
    "residentSampleCount": { "type": "integer", "minimum": 128 },
    "sequentialSampleCount": { "const": 10 },
    "concurrentSampleCount": { "const": 32 },
    "failureInjections": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cancel-before-terminal",
          "bounded-mailbox-saturation",
          "stale-content-binding"
        ]
      },
      "contains": { "const": "cancel-before-terminal" },
      "allOf": [
        { "contains": { "const": "bounded-mailbox-saturation" } },
        { "contains": { "const": "stale-content-binding" } }
      ]
    },
    "cacheStates": {
      "const": [
        {
          "state": "cold-build",
          "prepareAction": "new-isolated-workspace-generation",
          "mutationScope": "benchmark-workspace-generation",
          "sampleCount": 1
        },
        {
          "state": "cold-load",
          "prepareAction": "evict-resident-generation-only",
          "mutationScope": "benchmark-workspace-generation",
          "sampleCount": 10
        },
        {
          "state": "warm-read",
          "prepareAction": "reuse-exact-resident-generation",
          "mutationScope": "none",
          "sampleCount": 128
        },
        {
          "state": "released",
          "prepareAction": "release-exact-benchmark-generation",
          "mutationScope": "benchmark-workspace-generation",
          "sampleCount": 1
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "requiredClientProtocolTelemetryEvents": {
      "const": ["client_protocol_initialize", "client_protocol_catalog", "client_protocol_request", "client_protocol_cancel", "client_protocol_cancelled", "client_protocol_shutdown"]
    },
    "clientProtocolContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolId", "protocolVersion", "transport", "phases", "requiredTelemetryEvents", "appliesToCaseCount", "maximumResidentMicros", "sessionPolicy", "readyEffects", "forbiddenReadyEffects", "nonReadyDispatchCount", "residualTaskCount", "p50MaximumMicros", "p99MaximumMicros", "maxMaximumMicros"],
      "properties": {
        "protocolId": { "const": "agent.semantic-protocols.client" },
        "protocolVersion": { "const": "1" },
        "transport": { "const": "grpc-tokio-streams" },
        "phases": { "const": ["initialize", "catalog", "request", "cancel", "cancelled", "shutdown"] },
        "requiredTelemetryEvents": { "$ref": "#/$defs/requiredClientProtocolTelemetryEvents" },
        "appliesToCaseCount": { "const": 17 },
        "maximumResidentMicros": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "sessionPolicy": { "const": "one-initialize-per-session" },
        "readyEffects": { "const": ["mpsc", "oneshot", "cancel", "response"] },
        "forbiddenReadyEffects": { "const": ["process", "filesystem", "dbWrite", "generationMutation", "providerActivation", "controlPoll"] },
        "nonReadyDispatchCount": { "const": 0 },
        "residualTaskCount": { "const": 0 },
        "p50MaximumMicros": { "const": 250 },
        "p99MaximumMicros": { "const": 700 },
        "maxMaximumMicros": { "const": 1000 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "resourceId",
        "scenarioId",
        "languageId",
        "providerId",
        "search",
        "query",
        "zeroMatchTerms",
        "requiredTelemetryEvents"
      ],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": "string", "minLength": 1 },
        "languageId": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "terms", "view", "minimumCandidates", "maximumResidentMicros"],
          "properties": {
            "method": { "const": "lexical" },
            "terms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "view": { "const": "seeds" },
            "minimumCandidates": { "type": "integer", "minimum": 1 },
            "maximumResidentMicros": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selectorStrategy", "ownerView", "projectionScope", "maximumResidentMicros"],
          "properties": {
            "selectorStrategy": { "const": "first-ranked-parser-owned" },
            "ownerView": { "const": "items" },
            "projectionScope": { "const": "live-corpus" },
            "maximumResidentMicros": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "zeroMatchTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredTelemetryEvents": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "runtime_resident_search_terminal",
              "runtime_exact_projection_terminal"
            ]
          }
        }
      }
    }
  }
}
