{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/semantic-graph-turbo-resident-config.v1.schema.json",
  "title": "Graph Turbo resident artifact configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "artifactKind",
    "executionArtifactLocator",
    "executionArtifactDigest",
    "runtimeArtifactDigest"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.semantic-graph-turbo-resident-config"
    },
    "schemaVersion": {
      "const": "1"
    },
    "artifactKind": {
      "const": "standalone-directory"
    },
    "executionArtifactLocator": {
      "type": "string",
      "minLength": 1
    },
    "executionArtifactDigest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "runtimeArtifactDigest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    }
  }
}
