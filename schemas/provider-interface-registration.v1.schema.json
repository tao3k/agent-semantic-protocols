{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-interface-registration.v1.schema.json",
  "title": "ASP Provider Interface Registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "registrationId",
    "providerId",
    "languageId",
    "manifestDigest",
    "implementationDigest",
    "interfaceRefs",
    "availability"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.provider-interface-registration"
    },
    "schemaVersion": {
      "const": "1"
    },
    "registrationId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "implementationDigest": {
      "$ref": "#/$defs/digest"
    },
    "interfaceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interfaceId", "interfaceVersion"],
        "properties": {
          "interfaceId": {
            "type": "string",
            "minLength": 1
          },
          "interfaceVersion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "availability": {
      "enum": ["ready", "unavailable", "stale"]
    },
    "unavailableReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[0-9a-f]{64}$"
    }
  }
}
