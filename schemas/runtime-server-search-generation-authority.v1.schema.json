{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-server-search-generation-authority.v1.schema.json",
  "title": "Runtime Server Search Generation Authority v1",
  "description": "Compact resident generation identity returned to an agent-facing search consumer without owner bytes or rebuilt indexes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "workspaceIdentity",
    "projectRoot",
    "activeEpoch",
    "generationDigest",
    "sourceSnapshot",
    "workspaceGeneration"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-server-search-generation-authority"
    },
    "schemaVersion": {
      "const": "1"
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "activeEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "generationDigest": {
      "$ref": "#/$defs/wireDigest"
    },
    "sourceSnapshot": {
      "$ref": "source-snapshot-evidence.v1.schema.json#/$defs/sourceSnapshot"
    },
    "workspaceGeneration": {
      "$ref": "workspace-generation-root-evidence.v1.schema.json"
    }
  },
  "$defs": {
    "wireDigest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    }
  }
}
