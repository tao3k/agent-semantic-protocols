{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/workspace-search-playbook-plan.v1.schema.json",
  "title": "Workspace Search Playbook Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "projectId", "workspaceId",
    "contentGenerationDigest", "intent", "query", "normalizedTerms", "languageConstraint",
    "maxConcurrency", "routes", "skippedLanguages", "work"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.workspace-search-playbook-plan"},
    "schemaVersion": {"const": "1"},
    "projectId": {"type": "string", "minLength": 1},
    "workspaceId": {"type": "string", "minLength": 1},
    "contentGenerationDigest": {"$ref": "#/$defs/digest"},
    "intent": {"enum": ["conceptual", "relationship", "exact-literal", "absence-proof"]},
    "query": {"type": "string", "minLength": 1},
    "normalizedTerms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "languageConstraint": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 8},
    "routes": {
      "type": "array",
      "items": {"$ref": "#/$defs/route"}
    },
    "skippedLanguages": {
      "type": "array",
      "items": {"$ref": "#/$defs/skippedLanguage"}
    },
    "work": {"$ref": "#/$defs/zeroWarmWork"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageId", "providerId", "generationDigest", "extensions",
        "operation", "normalizedTerms", "selectors", "stages", "budget",
        "dependsOn", "publicCommand"
      ],
      "properties": {
        "languageId": {"type": "string", "minLength": 1},
        "providerId": {"type": "string", "minLength": 1},
        "generationDigest": {"$ref": "#/$defs/digest"},
        "extensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-zA-Z0-9.+_-]+$"}
        },
        "operation": {"enum": ["search", "query"]},
        "normalizedTerms": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "selectors": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "stages": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"$ref": "#/$defs/rgStage"},
            {"$ref": "#/$defs/nativeSyntaxStage"},
            {"$ref": "#/$defs/lexicalStage"},
            {"$ref": "#/$defs/pythonGraphStage"}
          ],
          "items": false
        },
        "budget": {
          "type": "object", "additionalProperties": false,
          "required": ["maxResults", "maxGraphNodes", "deadlineMillis"],
          "properties": {
            "maxResults": {"type": "integer", "minimum": 1},
            "maxGraphNodes": {"type": "integer", "minimum": 1},
            "deadlineMillis": {"type": "integer", "minimum": 1, "maximum": 1000}
          }
        },
        "dependsOn": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "publicCommand": {
          "type": "array", "minItems": 5,
          "prefixItems": [
            {"const": "asp"}, {"type": "string", "minLength": 1},
            {"const": "search"}, {"const": "playbook"},
            {"type": "string", "minLength": 1}
          ],
          "items": {"type": "string"}
        }
      }
    },
    "skippedLanguage": {
      "type": "object", "additionalProperties": false,
      "required": ["languageId", "reasonKind"],
      "properties": {
        "languageId": {"type": "string", "minLength": 1},
        "reasonKind": {
          "enum": [
            "language-not-selected", "provider-unavailable", "generation-unavailable",
            "source-scope-empty", "intent-not-supported"
          ]
        }
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "authority", "policy", "dependsOn"],
      "properties": {
        "stage": {"enum": ["rg-acquisition", "provider-native-syntax", "tantivy-lexical", "python-graph"]},
        "authority": {"type": "string", "minLength": 1},
        "policy": {"enum": ["content-required", "accelerator-if-ready", "intent-required", "skipped"]},
        "dependsOn": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["rg-acquisition", "provider-native-syntax", "tantivy-lexical", "python-graph"]}
        }
      }
    },
    "rgStage": {
      "allOf": [
        {"$ref": "#/$defs/stage"},
        {"properties": {"stage": {"const": "rg-acquisition"}, "policy": {"const": "content-required"}}}
      ]
    },
    "nativeSyntaxStage": {
      "allOf": [
        {"$ref": "#/$defs/stage"},
        {"properties": {"stage": {"const": "provider-native-syntax"}, "policy": {"const": "content-required"}}}
      ]
    },
    "lexicalStage": {
      "allOf": [
        {"$ref": "#/$defs/stage"},
        {"properties": {"stage": {"const": "tantivy-lexical"}, "policy": {"const": "accelerator-if-ready"}}}
      ]
    },
    "pythonGraphStage": {
      "allOf": [
        {"$ref": "#/$defs/stage"},
        {"properties": {
          "stage": {"const": "python-graph"},
          "policy": {"enum": ["intent-required", "skipped"]}
        }}
      ]
    },
    "zeroWarmWork": {
      "type": "object", "additionalProperties": false,
      "required": [
        "filesystemReadCount", "providerProcessCount", "socketDiscoveryCount"
      ],
      "properties": {
        "filesystemReadCount": {"const": 0},
        "providerProcessCount": {"const": 0},
        "socketDiscoveryCount": {"const": 0}
      }
    }
  }
}
