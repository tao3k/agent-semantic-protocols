{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-release-catalog.v1.schema.json",
  "title": "Provider Release Catalog V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "releases"],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.provider-release-catalog" },
    "schemaVersion": { "const": "1" },
    "releases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageId",
        "providerId",
        "binary",
        "repo",
        "version",
        "downloadBaseUrl",
        "supportedTargets",
        "sha256ByTarget"
      ],
      "properties": {
        "languageId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "providerId": { "type": "string", "pattern": "^asp-[a-z][a-z0-9-]*$" },
        "binary": { "type": "string", "pattern": "^asp-[a-z][a-z0-9-]*$" },
        "repo": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "downloadBaseUrl": { "type": "string", "pattern": "^https://" },
        "archivePrefix": { "type": "string", "minLength": 1 },
        "archiveBinary": { "type": "string", "minLength": 1 },
        "requireNativeBinary": { "type": "boolean" },
        "supportedTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sha256ByTarget": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
