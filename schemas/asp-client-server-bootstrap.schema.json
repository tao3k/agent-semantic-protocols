{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/asp-client-server-bootstrap.schema.json",
  "title": "ASP Client Server Bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "providerId",
    "transport",
    "state",
    "endpoint"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.asp-client-server-bootstrap"
    },
    "schemaVersion": {
      "const": "1"
    },
    "providerId": {
      "type": "string",
      "pattern": "^asp-[a-z0-9][a-z0-9-]*$"
    },
    "transport": {
      "const": "http-json"
    },
    "state": {
      "const": "ready"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$"
    }
  }
}
