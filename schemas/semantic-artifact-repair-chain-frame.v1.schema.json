{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/semantic-artifact-repair-chain-frame.v1.schema.json",
  "title": "ASP Merkle repair-chain frame v1",
  "description": "Typed Merkle frame linking how-from evidence, how-fix plans, change sets, graph diffs, and proof receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frameKind",
    "root",
    "contentHash",
    "parents"
  ],
  "properties": {
    "frameKind": {
      "enum": [
        "howFromFrame",
        "howFixFrame",
        "changeSet",
        "proofReceipt",
        "graphDiff"
      ]
    },
    "root": {
      "$ref": "#/$defs/artifactRootRef"
    },
    "contentHash": {
      "$ref": "#/$defs/artifactHash"
    },
    "parents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repairChainParentRef"
      }
    }
  },
  "$defs": {
    "artifactHash": {
      "$ref": "semantic-artifact-definitions.v1.schema.json#/$defs/artifactHash"
    },
    "artifactRootRef": {
      "$ref": "semantic-artifact-definitions.v1.schema.json#/$defs/artifactRootRef"
    },
    "repairChainParentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "ordinal",
        "root"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "root": {
          "$ref": "#/$defs/artifactRootRef"
        }
      }
    }
  }
}
