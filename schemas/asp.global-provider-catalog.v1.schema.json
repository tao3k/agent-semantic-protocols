{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/asp.global-provider-catalog.v1.schema.json",
  "title": "ASP Global Provider Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "catalogGeneration",
    "providers"
  ],
  "properties": {
    "schemaId": {
      "const": "asp.global-provider-catalog.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "catalogGeneration": {
      "$ref": "#/$defs/digest"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageId",
        "providerId",
        "manifestId",
        "manifestDigest",
        "runtimeContract",
        "materializedPath",
        "artifactDigest",
        "artifactMetadataDigest",
        "executionCommandDigest",
        "exactParserIdentityDigest",
        "argvPrefix",
        "providerRegistryDigest",
        "queryPackDigest",
        "exactQueryPackIdentityDigest"
      ],
      "properties": {
        "languageId": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
          "manifestDigest": {
            "$ref": "#/$defs/contentDigest"
          },
        "runtimeContract": {
          "$ref": "https://schemas.agent-semantic-protocols.dev/provider-runtime-contract-descriptor.schema.json"
        },
        "materializedPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "artifactMetadataDigest": {
          "$ref": "#/$defs/digest"
        },
        "executionCommandDigest": {
          "$ref": "#/$defs/contentDigest"
        },
        "exactParserIdentityDigest": {
          "$ref": "#/$defs/exactIdentityDigest"
        },
        "argvPrefix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "providerRegistryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "queryPackDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "exactQueryPackIdentityDigest": {
          "$ref": "#/$defs/exactIdentityDigest"
        }
      }
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[0-9a-f]{64}$"
    },
    "exactIdentityDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
