{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/asp.global-provider-catalog.v1.schema.json",
  "title": "ASP Global Provider Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "catalogGeneration",
    "providers"
  ],
  "properties": {
    "schemaId": {
      "const": "asp.global-provider-catalog.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "catalogGeneration": {
      "$ref": "#/$defs/digest"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageId",
        "providerId",
        "manifestId",
        "manifestDigest",
        "materializedPath",
        "artifactDigest",
        "artifactMetadataDigest",
        "executionCommandDigest",
        "semanticRegistryDigest"
      ],
      "properties": {
        "languageId": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
        "manifestDigest": {
          "$ref": "#/$defs/contentDigest"
        },
        "materializedPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "artifactMetadataDigest": {
          "$ref": "#/$defs/digest"
        },
        "executionCommandDigest": {
          "$ref": "#/$defs/contentDigest"
        },
        "semanticRegistryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[0-9a-f]{64}$"
    }
  }
}
