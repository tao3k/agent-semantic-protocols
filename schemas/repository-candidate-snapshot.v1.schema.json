{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/repository-candidate-snapshot.v1.schema.json",
  "title": "Repository Candidate Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "mode",
    "repositoryIdentity",
    "worktreeIdentity",
    "candidateGeneration",
    "candidates",
    "metrics"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.repository-candidate-snapshot"
    },
    "schemaVersion": {
      "const": "1"
    },
    "mode": {
      "const": "git"
    },
    "repositoryIdentity": {
      "$ref": "#/$defs/repositoryIdentity"
    },
    "worktreeIdentity": {
      "$ref": "#/$defs/worktreeIdentity"
    },
    "candidateGeneration": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "infrastructureExcludedPrefixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "uniqueItems": true
    },
    "snapshotDigest": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repositoryId",
        "root"
      ],
      "properties": {
        "kind": {
          "const": "git"
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "gitCommonDir": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "worktreeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "checkoutRoot",
        "sparseCheckout"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "checkoutRoot": {
          "type": "string",
          "minLength": 1
        },
        "gitDir": {
          "type": [
            "string",
            "null"
          ]
        },
        "headOid": {
          "type": [
            "string",
            "null"
          ]
        },
        "indexDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "sparseCheckout": {
          "type": "boolean"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "state",
        "authority"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "state": {
          "enum": [
            "indexed",
            "unchanged",
            "added",
            "modified",
            "deleted",
            "renamed",
            "untracked",
            "submodule-boundary"
          ]
        },
        "authority": {
          "enum": [
            "git-index",
            "git-worktree",
            "git-status",
            "git-untracked",
            "git-submodule"
          ]
        },
        "indexMode": {
          "enum": [
            "regular",
            "executable",
            "symlink",
            "gitlink"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCount",
        "trackedCount",
        "changedCount",
        "untrackedCount",
        "deletedCount",
        "fullWorkspaceReads",
        "elapsedMicros"
      ],
      "properties": {
        "candidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "trackedCount": {
          "type": "integer",
          "minimum": 0
        },
        "changedCount": {
          "type": "integer",
          "minimum": 0
        },
        "untrackedCount": {
          "type": "integer",
          "minimum": 0
        },
        "deletedCount": {
          "type": "integer",
          "minimum": 0
        },
        "fullWorkspaceReads": {
          "const": 0
        },
        "fullMerkleRebuilds": {
          "const": 0
        },
        "directDbOpens": {
          "const": 0
        },
        "elapsedMicros": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
