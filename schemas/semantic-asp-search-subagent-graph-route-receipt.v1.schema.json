{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/semantic-asp-search-subagent-graph-route-receipt.v1.schema.json",
  "title": "Semantic ASP Search Subagent GraphRoute Receipt v1",
  "description": "Bounded executable-evidence ASP Explorer handoff. Search exposes exact Query affordances but only a later asp query may materialize source.",
  "x-asp-natural-language-contract": {
    "example": "[asp-search-subagent]\nstate=candidates\nQueryGrammar: asp query --selector <exact-selector> --projection <callable-skeleton|source>\nE1 | owner=crates/agent-semantic-runtime | item=struct/RuntimeServingEndpoint | selector=rust://crates/agent-semantic-runtime#item/struct/RuntimeServingEndpoint | matchedBy=rg:0|syntax:0|graph:0 | relation=publishes-runtime-endpoint",
    "grammar": "receipt := candidates | empty | unavailable; candidates := header 'state=candidates' queryGrammar evidence{1,30}; empty := header 'state=empty'; unavailable := header 'state=unavailable' stage reasonKind; header := '[asp-search-subagent]'; queryGrammar := 'QueryGrammar: asp query --selector <exact-selector> --projection <callable-skeleton|source>'; stage := 'stage=' (registration|runtime|search|projection); reasonKind := 'reasonKind=' atom; evidence := 'E' digit+ ' | owner=' atom ' | item=' atom ' | selector=' exactSelector ' | matchedBy=' clauseRef ('|' clauseRef)* ' | relation=' atom; clauseRef := (fd|rg|tantivy|syntax|graph) ':' digit+; exactSelector := atom '#item/' atom; atom := non-whitespace+"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "protocolId",
    "protocolVersion",
    "kind",
    "receiptSchema",
    "state",
    "evidence"
  ],
  "properties": {
    "schemaId": {
      "const": "semantic-asp-search-subagent-graph-route-receipt.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "protocolId": {
      "const": "agent.semantic-protocols.search-subagent"
    },
    "protocolVersion": {
      "const": "1"
    },
    "kind": {
      "const": "asp-search-subagent"
    },
    "receiptSchema": {
      "const": "asp-search-subagent.graph.v1"
    },
    "state": {
      "description": "Typed outcome of the Search Playbook execution and Top-K ranking.",
      "enum": [
        "candidates",
        "empty",
        "unavailable"
      ]
    },
    "queryGrammar": {
      "const": "asp query --selector <exact-selector> --projection <callable-skeleton|source>"
    },
    "evidence": {
      "description": "The formal rank-ordered Top-K search result. It carries candidate identity and relation metadata only; source, snippets, excerpts, display ranges, fenced code, and source paraphrases are forbidden.",
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/evidenceNode"
      }
    },
    "stage": {
      "description": "Failed execution boundary. Present only when state is unavailable.",
      "enum": ["registration", "runtime", "search", "projection"]
    },
    "reasonKind": {
      "description": "Compact typed failure reason. Present only when state is unavailable.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "edges": {
      "description": "Optional compact EvidenceGraph relations between returned evidence nodes.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/routeEdge"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"state": {"const": "candidates"}},
        "required": ["state"]
      },
      "then": {
        "required": ["queryGrammar"],
        "properties": {"evidence": {"minItems": 1}},
        "not": {
          "anyOf": [
            {"required": ["stage"]},
            {"required": ["reasonKind"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"state": {"const": "empty"}},
        "required": ["state"]
      },
      "then": {
        "properties": {"evidence": {"maxItems": 0}},
        "not": {
          "anyOf": [
            {"required": ["queryGrammar"]},
            {"required": ["stage"]},
            {"required": ["reasonKind"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"state": {"const": "unavailable"}},
        "required": ["state"]
      },
      "then": {
        "required": ["stage", "reasonKind"],
        "properties": {"evidence": {"maxItems": 0}},
        "not": {"required": ["queryGrammar"]}
      }
    }
  ],
  "$defs": {
    "evidenceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "owner",
        "item",
        "selector",
        "matchedBy",
        "relation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        },
        "kind": {
          "enum": [
            "item",
            "owner",
            "test",
            "dependency",
            "doc",
            "policy",
            "scenario",
            "route"
          ]
        },
        "role": {
          "enum": [
            "primary",
            "guard",
            "context",
            "refine",
            "avoid"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "description": "Parser-owned selector or document-provider selector. Display line ranges are not valid identities.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*://.+#item/.+$",
          "not": {
            "pattern": ":[0-9]+([-:][0-9]+)?$"
          }
        },
        "matchedBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 69,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(fd|rg|tantivy|syntax|graph):[0-9]+$"
          }
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "selector-ready",
            "inventory-only",
            "stale-index",
            "invalid-selector",
            "empty-payload",
            "quarantined"
          ]
        }
      }
    },
    "routeEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "relation",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        }
      }
    }
  }
}
