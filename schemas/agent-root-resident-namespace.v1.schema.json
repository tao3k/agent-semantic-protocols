{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/agent-root-resident-namespace.v1.schema.json",
  "title": "ASP Root Resident Namespace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "rootSessionId",
    "configuredResidentIds",
    "residents",
    "temporarySessions",
    "nonMatchedChildren",
    "generation"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.agent-root-resident-namespace"},
    "schemaVersion": {"const": "1"},
    "rootSessionId": {"type": "string", "minLength": 1},
    "configuredResidentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "residents": {
      "type": "array",
      "items": {"$ref": "agent-session-host-binding.v1.schema.json"}
    },
    "temporarySessions": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "agent-session-host-binding.v1.schema.json"},
          {"properties": {"sessionLifetime": {"const": "temporary"}}}
        ]
      }
    },
    "nonMatchedChildren": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostChildId", "hostTaskName", "matchDecision"],
        "properties": {
          "hostChildId": {"type": "string", "minLength": 1},
          "hostTaskName": {"type": "string", "minLength": 1},
          "matchDecision": {"const": "none"}
        }
      }
    },
    "generation": {"type": "integer", "minimum": 0}
  }
}
