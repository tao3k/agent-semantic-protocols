{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/asp-schema-lifecycle-manifest.v1.schema.json",
  "title": "ASP Schema Lifecycle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "entries"],
  "properties": {
    "schemaId": {"const": "asp.schema-lifecycle-manifest.v1"},
    "schemaVersion": {"const": "1"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaPath", "status", "owner", "rationale"],
      "properties": {
        "schemaPath": {"type": "string", "pattern": "^schemas/.+\\.schema\\.json$"},
        "status": {
          "enum": ["active", "deprecated", "retired", "removal-candidate"]
        },
        "owner": {"$ref": "#/$defs/nonEmptyString"},
        "rationale": {"$ref": "#/$defs/nonEmptyString"},
        "replacementRef": {"$ref": "#/$defs/nonEmptyString"},
        "sunsetAfter": {"type": "string", "format": "date"}
      }
    }
  }
}
