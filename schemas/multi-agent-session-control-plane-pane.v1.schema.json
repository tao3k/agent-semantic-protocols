{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/multi-agent-session-control-plane-pane.v1.schema.json",
  "title": "ASP Multi-Agent Session Control Plane Pane",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "orgInteractive", "hookRoute", "pane", "agent", "choices"],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.multi-agent-session-control-plane-pane"},
    "schemaVersion": {"const": "1"},
    "orgInteractive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "panelId", "method", "stage"],
      "properties": {
        "contractId": {"const": "agent.multi-agent-session-control-plane.v1"},
        "panelId": {"const": "multi-agent-session-control-plane"},
        "method": {"const": "choice"},
        "stage": {"const": "presentation"}
      }
    },
    "hookRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configRuleId", "targetAgentName", "targetAgentRole", "receiptKind", "commandDigest", "reasonKind"],
      "properties": {
        "configRuleId": {"type": "string", "minLength": 1},
        "targetAgentName": {"type": "string", "minLength": 1},
        "targetAgentRole": {"type": "string", "minLength": 1},
        "receiptKind": {"type": "string", "minLength": 1},
        "commandDigest": {"type": ["string", "null"]},
        "reasonKind": {"type": "string", "minLength": 1}
      }
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paneId", "nodeId", "generation", "historyCursor", "reasonKind", "failure"],
      "properties": {
        "paneId": {"const": "session"},
        "nodeId": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 0},
        "historyCursor": {"type": "string", "minLength": 1},
        "reasonKind": {"type": ["string", "null"]},
        "failure": {"type": ["string", "null"]}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeKey", "sessionName", "sessionLifetime", "platform", "hostAgentName", "roles", "roleDescription", "sandboxMode", "residentId", "matchDecision", "binding"],
      "properties": {
        "routeKey": {"type": "string", "minLength": 1},
        "sessionName": {"type": "string", "minLength": 1},
        "sessionLifetime": {"enum": ["resident", "temporary"]},
        "residentId": {"type": "string", "minLength": 1},
        "matchDecision": {"const": "matched"},
        "binding": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "agent-session-host-binding.v1.schema.json"}
          ]
        },
        "platform": {"enum": ["codex", "claude"]},
        "hostAgentName": {"type": "string", "minLength": 1},
        "roleDescription": {"type": "string", "minLength": 1},
        "sandboxMode": {"type": "string", "minLength": 1},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instruction", "presentation", "why"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "instruction": {"type": "string", "minLength": 1},
          "presentation": {"enum": ["action", "pane"]},
          "why": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pane": {
            "properties": {"nodeId": {"const": "registered"}},
            "required": ["nodeId"]
          }
        },
        "required": ["pane"]
      },
      "then": {
        "properties": {
          "agent": {
            "properties": {
              "binding": {
                "allOf": [
                  {"$ref": "agent-session-host-binding.v1.schema.json"},
                  {
                    "properties": {
                      "lifecycleState": {"const": "live"},
                      "routable": {"const": true}
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pane": {
            "properties": {"nodeId": {"const": "registration-required"}},
            "required": ["nodeId"]
          }
        },
        "required": ["pane"]
      },
      "then": {
        "properties": {
          "agent": {"properties": {"binding": {"type": "null"}}}
        }
      }
    }
  ]
}
