{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-provider-search-request.v1.schema.json",
  "title": "Runtime Provider Search Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "operationId",
    "projectId",
    "workspaceId",
    "languageId",
    "scope",
    "queryPlan"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-provider-search-request"
    },
    "schemaVersion": { "const": "1" },
    "operationId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "languageId": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["production", "live-corpus"] },
    "queryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "terms", "view"],
      "properties": {
        "method": { "enum": ["lexical", "semantic", "hybrid"] },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "view": { "type": "string", "minLength": 1 },
        "ownerPath": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
