{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/semantic-search-relation-batch.v1.schema.json",
  "title": "Semantic Search Relation Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "abiVersion",
    "sourceSnapshotDigest",
    "producer",
    "relations"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.search-relation-batch.v1"
    },
    "schemaVersion": { "const": "1" },
    "abiVersion": { "const": 1 },
    "sourceSnapshotDigest": { "$ref": "#/$defs/digest" },
    "producer": { "$ref": "#/$defs/producer" },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[a-f0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "languageId", "artifactDigest"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "languageId": { "type": "string", "minLength": 1 },
        "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "valueType"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "valueType": {
          "enum": [
            "node-ref",
            "edge-ref",
            "path-ref",
            "evidence-ref",
            "obligation-ref",
            "natural",
            "scalar"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationId",
        "authority",
        "columns",
        "rows",
        "provenanceDigest"
      ],
      "properties": {
        "relationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "authority": { "enum": ["candidate", "observed", "derived"] },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": ["string", "integer", "number", "boolean", "null"]
            }
          }
        },
        "provenanceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
