{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-runtime-contract-descriptor.v1.schema.json",
  "title": "ASP Provider Runtime Contract Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["transport", "operations"],
  "properties": {
    "transport": {
      "enum": ["runtime-ipc", "http-json", "in-process"]
    },
    "aspClientServer": {
        "$ref": "asp-client-server-descriptor.v1.schema.json"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "requestSchemaId", "responseSchemaId"],
        "properties": {
          "operation": { "type": "string", "minLength": 1 },
          "requestSchemaId": { "type": "string", "minLength": 1 },
          "responseSchemaId": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "transport": { "const": "http-json" } } },
      "then": { "required": ["aspClientServer"] },
      "else": { "not": { "required": ["aspClientServer"] } }
    }
  ]
}
