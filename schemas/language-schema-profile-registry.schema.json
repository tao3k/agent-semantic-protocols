{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/language-schema-profile-registry.schema.json",
  "title": "ASP Language Schema Profile Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaId", "schemaVersion", "families", "referenceDecisions", "rootSets", "profiles"],
  "properties": {
    "$schema": { "const": "language-schema-profile-registry.schema.json" },
    "schemaId": { "const": "agent.semantic-protocols.language-schema-profile-registry" },
    "schemaVersion": { "const": "1" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "asp-schema-family-registry.v1.schema.json#/$defs/family" }
    },
    "referenceDecisions": {
      "type": "array",
      "items": { "$ref": "asp-schema-reference-decision-registry.v1.schema.json#/$defs/entry" }
    },
    "rootSets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/schemaNames" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["languageId", "packageRoot", "bundleRoot", "rootSets", "roots", "providerOwned"],
        "properties": {
          "languageId": { "type": "string", "minLength": 1 },
          "packageRoot": { "type": "string", "minLength": 1 },
          "bundleRoot": { "type": "string", "minLength": 1 },
          "rootSets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "roots": { "$ref": "#/$defs/schemaNames" },
          "providerOwned": { "$ref": "#/$defs/schemaNames" }
        }
      }
    }
  },
  "$defs": {
    "schemaNames": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[^/]+\\.schema\\.json$" }
    }
  }
}
