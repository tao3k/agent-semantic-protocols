{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/provider-runtime-authority-receipt.v1.schema.json",
  "title": "Provider Runtime Authority Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "providerId",
    "languageId",
    "state",
    "contractReceipt",
    "error"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.provider-runtime-authority-receipt"
    },
    "schemaVersion": {
      "const": "1"
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": ["starting", "warming", "ready", "draining", "failed", "stopped"]
    },
    "contractReceipt": {
      "oneOf": [
        { "$ref": "provider-runtime-contract-receipt.v1.schema.json" },
        { "type": "null" }
      ]
    },
    "error": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "ready" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "contractReceipt": { "$ref": "provider-runtime-contract-receipt.v1.schema.json" },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "failed" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "contractReceipt": { "type": "null" },
          "error": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
