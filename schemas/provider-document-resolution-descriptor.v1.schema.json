{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/provider-document-resolution-descriptor.v1.schema.json",
  "title": "Provider Document Resolution Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "capabilityId",
    "extensions",
    "parserId",
    "supportsGitCandidates"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.provider-document-resolution-descriptor"
    },
    "schemaVersion": {
      "const": "1"
    },
    "capabilityId": {
      "const": "document-resolution"
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.[A-Za-z0-9._+-]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "parserId": {
      "type": "string",
      "minLength": 1
    },
    "supportsGitCandidates": {
      "const": true
    }
  }
}
