{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.dev/schemas/runtime-server-performance-observation.v1.schema.json",
  "title": "Runtime Server Performance Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "surface",
    "stage",
    "elapsedMicros",
    "budgetMicros",
    "budgetStatus"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-server-performance-observation"
    },
    "schemaVersion": { "const": "1" },
    "surface": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "workspaceIdentity": { "type": ["string", "null"], "minLength": 1 },
    "sessionId": { "type": ["string", "null"], "minLength": 1 },
    "requestId": { "type": ["string", "null"], "minLength": 1 },
    "languageId": { "type": ["string", "null"], "minLength": 1 },
    "providerId": { "type": ["string", "null"], "minLength": 1 },
    "languageIds": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "providerIds": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "workspaceSnapshotDigest": { "type": ["string", "null"], "pattern": "^blake3-256:[0-9a-f]{64}$" },
    "sourceSnapshotDigest": { "type": ["string", "null"], "pattern": "^blake3-256:[0-9a-f]{64}$" },
    "sourceIndexDigest": { "type": ["string", "null"], "pattern": "^blake3-256:[0-9a-f]{64}$" },
    "generationDigest": { "type": ["string", "null"], "minLength": 1 },
    "runtimeArtifactDigest": { "type": ["string", "null"], "minLength": 1 },
    "runtimeBundleDigest": { "type": ["string", "null"], "pattern": "^blake3-256:[0-9a-f]{64}$" },
    "executionPublicationDigest": { "type": ["string", "null"], "pattern": "^blake3-256:[0-9a-f]{64}$" },
    "providerCatalogDigest": { "type": ["string", "null"], "pattern": "^blake3-256:[0-9a-f]{64}$" },
    "transportContractDigest": { "type": ["string", "null"], "minLength": 1 },
    "operationId": { "type": ["string", "null"], "minLength": 1 },
    "eventIdentity": { "type": ["string", "null"], "minLength": 1 },
    "incidentId": { "type": ["string", "null"], "minLength": 1 },
    "incidentState": { "type": ["string", "null"], "minLength": 1 },
    "incidentTransition": { "type": ["string", "null"], "minLength": 1 },
    "incidentTransitionSequence": { "type": ["integer", "null"], "minimum": 0 },
    "requestedProjection": { "type": ["string", "null"], "minLength": 1 },
    "observedAtUnixMicros": { "type": ["integer", "null"], "minimum": 0 },
    "processResidentBytes": { "type": ["integer", "null"], "minimum": 0 },
    "processPeakResidentBytes": { "type": ["integer", "null"], "minimum": 0 },
    "processMemoryBudgetBytes": { "type": ["integer", "null"], "minimum": 0 },
    "processMemoryBudgetStatus": { "type": ["string", "null"], "minLength": 1 },
    "processDiskReadBytes": { "type": ["integer", "null"], "minimum": 0 },
    "processDiskWriteBytes": { "type": ["integer", "null"], "minimum": 0 },
    "processPageIns": { "type": ["integer", "null"], "minimum": 0 },
    "processOpenDescriptors": { "type": ["integer", "null"], "minimum": 0 },
    "processOpenDescriptorBudget": { "type": ["integer", "null"], "minimum": 0 },
    "processOpenDescriptorBudgetStatus": { "type": ["string", "null"], "minLength": 1 },
    "runtimeEventLoopLagMicros": { "type": ["integer", "null"], "minimum": 0 },
    "runtimeEventLoopLagBudgetMicros": { "type": ["integer", "null"], "minimum": 0 },
    "runtimeEventLoopLagBudgetStatus": { "type": ["string", "null"], "minLength": 1 },
    "runtimeWorkerThreads": { "type": ["integer", "null"], "minimum": 1 },
    "runtimeAliveTasks": { "type": ["integer", "null"], "minimum": 0 },
    "runtimeGlobalQueueDepth": { "type": ["integer", "null"], "minimum": 0 },
    "runtimeActiveConnections": { "type": ["integer", "null"], "minimum": 0 },
    "runtimeConnectionLimit": { "type": ["integer", "null"], "minimum": 1 },
    "runtimeConnectionHighWatermark": { "type": ["integer", "null"], "minimum": 0 },
    "runtimeRejectedConnections": { "type": ["integer", "null"], "minimum": 0 },
    "runtimeDiagnosticQueueDepth": { "type": ["integer", "null"], "minimum": 0 },
    "runtimeDiagnosticQueueCapacity": { "type": ["integer", "null"], "minimum": 1 },
    "runtimeDroppedDiagnostics": { "type": ["integer", "null"], "minimum": 0 },
    "ownerCount": { "type": ["integer", "null"], "minimum": 0 },
    "selectorCount": { "type": ["integer", "null"], "minimum": 0 },
    "relationCount": { "type": ["integer", "null"], "minimum": 0 },
    "sourceBytes": { "type": ["integer", "null"], "minimum": 0 },
    "projectionBytes": { "type": ["integer", "null"], "minimum": 0 },
    "canonicalEncodedBytes": { "type": ["integer", "null"], "minimum": 0 },
    "memorySearchMappedBytes": { "type": ["integer", "null"], "minimum": 0 },
    "memorySearchDirectoryBytesValidated": { "type": ["integer", "null"], "minimum": 0 },
    "memorySearchKeyBytesTouched": { "type": ["integer", "null"], "minimum": 0 },
    "memorySearchValueBytesTouched": { "type": ["integer", "null"], "minimum": 0 },
    "memorySearchSourceBytesRead": { "type": ["integer", "null"], "minimum": 0 },
    "memorySearchTursoOpens": { "type": ["integer", "null"], "minimum": 0 },
    "memorySearchSocketConnects": { "type": ["integer", "null"], "minimum": 0 },
    "memorySearchProviderSpawns": { "type": ["integer", "null"], "minimum": 0 },
    "elapsedMicros": { "type": "integer", "minimum": 0 },
    "budgetMicros": { "type": "integer", "minimum": 1 },
    "budgetStatus": { "type": "string", "minLength": 1 },
    "failureReason": { "type": ["string", "null"], "minLength": 1 },
    "retryAfterMs": { "type": ["integer", "null"], "minimum": 0 }
  }
}
