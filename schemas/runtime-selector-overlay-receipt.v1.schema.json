{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-selector-overlay-receipt.v1.schema.json",
  "title": "ASP Runtime Selector Overlay Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "workspaceIdentity",
    "generationDigest",
    "projectionKind",
    "structuralSelector",
    "inserted"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-server-selector-overlay-receipt.v1"
    },
    "schemaVersion": {
      "const": "1"
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1
    },
    "generationDigest": {
      "type": "string",
      "pattern": "^(blake3-256:)?[0-9a-f]{64}$"
    },
    "projectionKind": {
      "enum": [
        "source",
        "callable-skeleton"
      ]
    },
    "structuralSelector": {
      "type": "string",
      "minLength": 1
    },
    "inserted": {
      "type": "boolean"
    }
  }
}
