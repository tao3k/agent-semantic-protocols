{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.child-session-registration.v2.schema.json",
  "title": "Agent Child Session Registration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "projectId", "rootSessionId",
    "parentSessionId", "childSessionId", "residentId", "routeKey",
    "profileId", "profileDigest", "modelId", "modelDigest", "sandboxMode",
    "sessionLifetime", "generation", "lifecycleState", "routable",
    "hostCallReceiptDigest", "registrationAuthority"
  ],
  "properties": {
    "schemaId": { "const": "agent.child-session-registration.v2" },
    "schemaVersion": { "const": "2" },
    "projectId": { "type": "string", "minLength": 1 },
    "rootSessionId": { "type": "string", "minLength": 1 },
    "parentSessionId": { "type": "string", "minLength": 1 },
    "childSessionId": { "type": "string", "minLength": 1 },
    "residentId": { "type": "string", "minLength": 1 },
    "routeKey": { "type": "string", "minLength": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "profileDigest": { "type": "string", "pattern": "^blake3-256:" },
    "modelId": { "type": "string", "minLength": 1 },
    "modelDigest": { "type": "string", "pattern": "^blake3-256:" },
    "sandboxMode": { "type": "string", "minLength": 1 },
    "sessionLifetime": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "lifecycleState": { "const": "live" },
    "routable": { "const": true },
    "hostCallReceiptDigest": { "type": "string", "pattern": "^blake3-256:" },
    "registrationAuthority": { "const": "project-child-registration-authority" }
  }
}
