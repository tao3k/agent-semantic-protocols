{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/active-generation-projection-capability.v1.schema.json",
  "title": "Active Generation Projection Capability V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "state",
    "workspaceIdentity",
    "generationDigest",
    "rootDigest",
    "providerCatalogDigest",
    "providerCatalogReadable",
    "publicationEpoch",
    "selectors"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.active-generation-projection-capability"
    },
    "schemaVersion": {
      "const": "1"
    },
    "state": {
      "enum": ["building", "ready", "failed"]
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1
    },
    "generationDigest": {
      "$ref": "#/$defs/digest"
    },
    "rootDigest": {
      "$ref": "#/$defs/digest"
    },
    "providerCatalogDigest": {
      "$ref": "#/$defs/digest"
    },
    "providerCatalogReadable": {
      "type": "boolean"
    },
    "publicationEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "selectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selectorCapability"
      }
    },
    "failure": {
      "$ref": "#/$defs/failure"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "providerCatalogReadable": {
            "const": true
          },
          "selectors": {
            "minItems": 1
          }
        },
        "not": {
          "required": ["failure"]
        }
      },
      "else": {
        "if": {
          "properties": {
            "state": {
              "const": "failed"
            }
          },
          "required": ["state"]
        },
        "then": {
          "required": ["failure"]
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(blake3-256:|sha256:)?[0-9a-f]{64}$"
    },
    "selectorCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "ownerPath", "projectionModes"],
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "ownerPath": {
          "type": "string",
          "minLength": 1
        },
        "projectionModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["source", "callable-skeleton"]
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonKind", "message"],
      "properties": {
        "reasonKind": {
          "enum": [
            "provider-catalog-unavailable",
            "owner-not-admitted",
            "projection-capability-missing",
            "projection-segment-unavailable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
