{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/global-resident-control.v1.schema.json",
  "title": "ASP global resident control",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "schemaVersion", "operation", "requestId"],
      "properties": {
        "schemaId": {"const": "agent.semantic-protocols.global-resident-control-request.v1"},
        "schemaVersion": {"const": "1"},
        "operation": {"enum": ["inspect", "reconcile"]},
        "requestId": {"type": "string", "minLength": 1}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "requestId",
        "state",
        "runtimeArtifactDigest",
        "transportContractDigest",
        "workspaceEntryCount"
      ],
      "properties": {
        "schemaId": {"const": "agent.semantic-protocols.global-resident-control-receipt.v1"},
        "schemaVersion": {"const": "1"},
        "requestId": {"type": "string", "minLength": 1},
        "state": {"enum": ["healthy", "degraded", "unavailable"]},
        "runtimeArtifactDigest": {"type": "string", "minLength": 1},
        "transportContractDigest": {"type": "string", "minLength": 1},
        "workspaceEntryCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
