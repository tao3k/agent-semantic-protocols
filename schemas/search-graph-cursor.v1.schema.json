{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/search-graph-cursor.v1.schema.json",
  "title": "Search Graph Cursor v1",
  "description": "Durable, language-neutral navigation state over one content-addressed materialized search graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "loopId",
    "graphArtifact",
    "state",
    "materializedNodeIds"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.search-graph-cursor"
    },
    "schemaVersion": {
      "const": "1"
    },
    "loopId": {
      "$ref": "search-loop-runtime-binding.v1.schema.json#/$defs/typedId"
    },
    "graphArtifact": {
      "$ref": "search-loop-runtime-binding.v1.schema.json#/$defs/artifactBinding"
    },
    "state": {
      "$ref": "interactive-search-graph-step.v1.schema.json#/$defs/graphState"
    },
    "materializedNodeIds": {
      "$ref": "interactive-search-graph-step.v1.schema.json#/$defs/stringSet",
      "minItems": 1
    }
  }
}
