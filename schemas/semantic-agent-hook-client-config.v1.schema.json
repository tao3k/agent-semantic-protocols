{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/semantic-agent-hook-client-config.v1.schema.json",
  "title": "Semantic Agent Hook Client Config",
  "description": "Optional client-side semantic hook rules loaded by asp hook on each invocation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.hook.client-config"
    },
    "schemaVersion": {
      "const": "1"
    },
    "protocolId": {
      "const": "agent.semantic-protocols.hook"
    },
    "protocolVersion": {
      "const": "1"
    },
    "wrapper_match": {
      "const": "enable"
    },
    "agents": {
      "$ref": "#/$defs/agents"
    },
    "commandProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandProfile"
      }
    },
    "languageProviders": {
      "description": "Managed runtime projection of provider-manifest-owned language source extensions. The provider manifest remains authoritative; this projection is serialized for audited hook matching.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageProvider"
      }
    },
    "actionPolicies": {
      "description": "Reusable predicates over normalized AgentAction envelopes. Rules compose predicates while retaining ownership of decisions and dispatch.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionPolicy"
      }
    },
    "agentOrgArtifacts": {
      "$ref": "#/$defs/agentOrgArtifacts"
    },
    "aspCommandIntentPolicy": {
      "$ref": "#/$defs/aspCommandIntentPolicy"
    },
    "executionLanes": {
      "$ref": "#/$defs/executionLanes"
    },
    "rules": {
      "description": "Typed client-hook rules. Rule ids are runtime-validated as unique because config-derived decisions use fields.configRuleId as the machine receipt.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "contractFingerprint": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "experimental": {
      "$ref": "#/$defs/experimental"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "typedActionKind": {
      "enum": ["read", "edit", "search", "enumerate", "execute", "test", "build", "delete", "unknown"]
    },
    "typedSubjectKind": {
      "enum": ["registered-language-source", "registered-language-source-pattern", "provider-config-file", "directory", "structural-selector", "other"]
    },
    "typedAuthority": {
      "enum": ["raw-host-action", "raw-shell", "parser-owned-exact-evidence", "parser-owned-search", "ast-patch-evidence", "unknown"]
    },
    "actionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "actionAny": { "type": "array", "items": { "$ref": "#/$defs/typedActionKind" } },
        "effectAny": { "type": "array", "items": { "$ref": "#/$defs/typedActionKind" } },
        "subjectKindAny": { "type": "array", "items": { "$ref": "#/$defs/typedSubjectKind" } },
        "authorityAny": { "type": "array", "items": { "$ref": "#/$defs/typedAuthority" } },
        "authorityExcludeAny": { "type": "array", "items": { "$ref": "#/$defs/typedAuthority" } }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholders", "residentAgents"],
      "properties": {
        "placeholders": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          }
        },
        "residentAgents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/residentAgent"
          }
        }
      }
    },
    "residentAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "codexAgentName"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "codexAgentName": {
          "$ref": "#/$defs/identifier"
        },
        "sessionLifetime": {
          "enum": ["temporary", "resident"]
        }
      }
    },
    "commandProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "languageIds", "categories"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "languageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "categories": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "languageProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languageId",
        "providerId",
        "manifestDigest",
        "sourceExtensions"
      ],
      "properties": {
        "languageId": {
          "$ref": "#/$defs/identifier"
        },
        "providerId": {
          "$ref": "#/$defs/identifier"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[^/\\\\\\s]+$"
          }
        }
      }
    },
    "commandProfileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "category"],
      "properties": {
        "profile": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "agent", "receiptKind"],
      "properties": {
        "transport": {
          "const": "resident-agent"
        },
        "agent": {
          "$ref": "#/$defs/identifier"
        },
        "receiptKind": {
          "type": "string",
          "minLength": 1
        },
        "lazyProvider": {
          "enum": ["matched-language"]
        }
      }
    },
    "event": {
      "enum": [
        "pre-tool",
        "permission-request",
        "post-tool",
        "user-prompt",
        "session-start",
        "subagent-start",
        "subagent-stop",
        "stop"
      ]
    },
    "experimental": {
      "description": "Project-local experimental hook feature switches. Missing switches preserve the built-in classifier behavior.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semanticAstPatch": {
          "$ref": "#/$defs/experimentalFeature"
        }
      }
    },
    "experimentalFeature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "aspCommandIntentPolicy": {
      "description": "Parser-owned classification policy for public asp language commands.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlPlane": {
          "$ref": "#/$defs/aspControlPlaneIntent"
        },
        "reasoning": {
          "$ref": "#/$defs/aspReasoningIntent"
        },
        "exactEvidence": {
          "$ref": "#/$defs/aspExactEvidenceIntent"
        },
        "directReadFallback": {
          "$ref": "#/$defs/aspDirectReadFallbackIntent"
        },
        "invalidEvidence": {
          "$ref": "#/$defs/aspInvalidEvidenceIntent"
        }
      }
    },
    "executionLanes": {
      "description": "Deterministic command execution lanes that do not require a reasoning agent.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testing": {"$ref": "#/$defs/executionLane"}
      }
    },
    "executionLane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "transport": {"const": "current-session"},
        "commandPrefixes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "receiptKind": {"type": "string", "minLength": 1}
      }
    },
    "aspControlPlaneIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rootCommands": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "aspReasoningIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rootCommands": {"$ref": "#/$defs/nonEmptyStringArray"},
        "guideCommand": {"type": "boolean"},
        "searchRoutes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "queryFlags": {"$ref": "#/$defs/nonEmptyStringArray"},
        "unprojectedQuery": {"type": "boolean"}
      }
    },
    "aspExactEvidenceIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queryProjectionFlags": {"$ref": "#/$defs/nonEmptyStringArray"},
        "queryProjectionViews": {"$ref": "#/$defs/nonEmptyStringArray"},
        "selectorKinds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "requireSameLanguage": {"type": "boolean"}
      }
    },
    "aspDirectReadFallbackIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fromHookValues": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "aspInvalidEvidenceIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rejectProjectedQueryWithoutExactSelector": {"type": "boolean"},
        "rejectCrossLanguageSelector": {"type": "boolean"}
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agentOrgArtifacts": {
      "$ref": "semantic-agent-definitions.v1.schema.json#/$defs/agentOrgArtifacts"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision"],
      "allOf": [
        {
          "if": {
            "required": ["terminal"],
            "properties": { "terminal": { "const": true } }
          },
          "then": {
            "properties": { "decision": { "const": "allow" } }
          }
        },
        {
          "if": {
            "required": ["decisionMaterializer"],
            "properties": {
              "decisionMaterializer": { "type": "string" }
            }
          },
          "then": {
            "properties": {
              "routes": { "maxItems": 0 }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer"
        },
        "terminal": {
          "description": "When true, a winning allow rule terminates Hook policy evaluation.",
          "type": "boolean"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "decision": {
          "enum": ["allow", "deny", "block"]
        },
        "decisionMaterializer": {
          "type": ["string", "null"],
          "enum": [
            "agent-search-json",
            "prompt-search-strategy",
            "invalid-asp-facade",
            "apply-patch",
            "source-access",
            null
          ]
        },
        "reasonKind": {
          "enum": [
            "none",
          "direct-source-read",
          "structured-source-read",
            "bulk-source-dump",
            "raw-broad-search",
            "asp-reasoning-routed",
            "agent-search-json",
            "subagent-receipt-required"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "languageIds": {
          "description": "Optional language filter. A rule with languageIds only matches action paths covered by activated providers for one of these languages.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "platform": {
          "enum": ["codex", "claude", "unknown"]
        },
        "match": {
          "$ref": "#/$defs/ruleMatch"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "ruleMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionPolicyAll": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "actionPolicyAny": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "actionPolicyNone": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "actionAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/typedActionKind" }
        },
        "effectAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/typedActionKind" }
        },
        "subjectKindAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/typedSubjectKind" }
        },
        "authorityAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/typedAuthority" }
        },
        "authorityExcludeAny": {
          "type": "array",
          "items": { "$ref": "#/$defs/typedAuthority" }
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "toolAny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commandAny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commandProfileAny": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/commandProfileRef"
          }
        },
        "argvPrefixAny": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "leadingEnvironmentAssignmentAny": {
          "description": "Exact NAME=VALUE assignments matched only in the leading assignment block of the first parsed shell stage.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*=.*$"
          }
        },
        "commandContainsAny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pathAny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pathGlobAny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "kind", "argv"],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/identifier"
        },
        "languageId": {
          "$ref": "#/$defs/identifier"
        },
        "binary": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "kind": {
          "enum": [
            "prime",
            "owner",
            "query",
            "lexical",
            "read",
            "deps",
            "api",
            "ingest",
            "tests",
            "check-changed"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "stdinMode": {
          "enum": ["none", "pipe-candidates", "pipe-diff", "unknown"]
        }
      }
    }
  }
}
