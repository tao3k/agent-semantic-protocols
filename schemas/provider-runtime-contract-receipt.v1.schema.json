{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/provider-runtime-contract-receipt.v1.schema.json",
  "title": "Provider Runtime Contract Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "providerId",
    "languageId",
    "artifactDigest",
    "manifestDigest",
    "contractDigest",
    "transport",
    "operations"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.provider-runtime-contract-receipt"
    },
    "schemaVersion": { "const": "1" },
    "providerId": { "type": "string", "minLength": 1 },
    "languageId": { "type": "string", "minLength": 1 },
    "artifactDigest": { "$ref": "#/$defs/digest" },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "contractDigest": { "$ref": "#/$defs/digest" },
    "transport": {
      "enum": ["framed-stdin-v1", "runtime-ipc-v1"]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(blake3-256|sha256):[0-9a-f]{64}$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "requestSchemaId", "responseSchemaId"],
      "properties": {
        "operation": {
          "enum": [
            "project-resolution",
            "source-ingest",
            "lexical-search",
            "owner-items",
            "exact-projection",
            "callable-skeleton",
            "dependency-topology"
          ]
        },
        "requestSchemaId": { "type": "string", "minLength": 1 },
        "responseSchemaId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
