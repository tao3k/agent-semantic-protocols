{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.semantic.protocols/schemas/state-home-sync-receipt",
  "title": "ASP State Home V1 Contract Sync Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "state",
    "stateHome",
    "removedEntries",
    "removedBytes"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.state-home-sync-receipt" },
    "schemaVersion": { "const": 1 },
    "state": { "const": "converged" },
    "stateHome": { "type": "string", "minLength": 1 },
    "removedEntries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "removedBytes": { "type": "integer", "minimum": 0 }
  }
}
