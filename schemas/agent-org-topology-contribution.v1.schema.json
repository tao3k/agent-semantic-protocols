{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-semantic-protocols.dev/agent-org-topology-contribution.v1.schema.json",
  "title": "Agent Org Topology Contribution V1",
  "description": "External reasoning Agent output bound to one exact Live Corpus topology evidence artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "schemaVersion", "caseId", "resourceId", "evidenceDigest",
    "agentIdentityDigest", "promptDigest", "summary", "orgSource", "relationships"
  ],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.agent-org-topology-contribution"},
    "schemaVersion": {"const": "1"},
    "caseId": {"type": "string", "minLength": 1},
    "resourceId": {"type": "string", "minLength": 1},
    "evidenceDigest": {"$ref": "#/$defs/digest"},
    "agentIdentityDigest": {"$ref": "#/$defs/digest"},
    "promptDigest": {"$ref": "#/$defs/digest"},
    "summary": {"type": "string", "minLength": 1},
    "orgSource": {"type": "string", "minLength": 1},
    "relationships": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromSelector", "relation", "toSelector"],
        "properties": {
          "fromSelector": {"type": "string", "minLength": 1},
          "relation": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "toSelector": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"}
  }
}
