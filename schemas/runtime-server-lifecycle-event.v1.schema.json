{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.dev/schemas/runtime-server-lifecycle-event.v1.schema.json",
  "title": "Runtime Server Lifecycle Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "ownerEpoch",
    "state",
    "elapsedMicros",
    "activeTaskCount",
    "activeChildCount"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.runtime-server-lifecycle-event" },
    "schemaVersion": { "const": "1" },
    "ownerEpoch": { "type": "integer", "minimum": 1 },
    "workspaceIdentity": { "type": ["string", "null"], "minLength": 1 },
    "generationDigest": { "type": ["string", "null"], "minLength": 1 },
    "transition": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["starting", "building", "ready", "failed", "cancelled", "draining", "exited"] },
    "elapsedMicros": { "type": "integer", "minimum": 0 },
    "readBytes": { "type": "integer", "minimum": 0 },
    "retainedBytes": { "type": "integer", "minimum": 0 },
    "activeTaskCount": { "type": "integer", "minimum": 0 },
    "activeChildCount": { "type": "integer", "minimum": 0 },
    "service": { "type": ["string", "null"], "minLength": 1 },
    "serviceState": { "type": ["string", "null"], "minLength": 1 },
    "serviceDrainMicros": { "type": ["integer", "null"], "minimum": 0 },
    "error": { "type": ["string", "null"], "minLength": 1 }
  }
}
