{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-provider-search-receipt.v1.schema.json",
  "title": "Runtime Provider Search Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "operationId",
    "status",
    "languageId",
    "readState",
    "candidateCount",
    "selectors",
    "statusCode",
    "stdout",
    "stderr",
    "residentReadElapsedMicros",
    "serviceElapsedMicros",
    "elapsedMicros"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-provider-search-receipt.v1"
    },
    "schemaVersion": { "const": "1" },
    "operationId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["matches", "no-matches", "failed"] },
    "languageId": { "type": "string", "minLength": 1 },
    "readState": {
      "enum": ["empty-index", "hit", "miss"]
    },
    "candidateCount": { "type": "integer", "minimum": 0 },
    "selectors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "statusCode": { "type": "integer" },
    "stdout": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "stderr": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "rootDigest": { "type": "string", "minLength": 1 },
    "providerDigest": { "type": "string", "minLength": 1 },
    "indexArtifactDigest": { "type": "string", "minLength": 1 },
    "residentReadElapsedMicros": { "type": "integer", "minimum": 0 },
    "serviceElapsedMicros": { "type": "integer", "minimum": 0 },
    "elapsedMicros": { "type": "integer", "minimum": 0 },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonKind", "message"],
      "properties": {
        "reasonKind": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "required": ["failure"] }
    }
  ]
}
