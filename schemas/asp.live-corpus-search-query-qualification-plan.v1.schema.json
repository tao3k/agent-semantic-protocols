{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/asp.live-corpus-search-query-qualification-plan.v1.schema.json",
  "title": "ASP Live Corpus Search Query Qualification Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "lockPath",
    "requiredLanguages",
    "residentSampleCount",
    "cases"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.live-corpus-search-query-qualification-plan"
    },
    "schemaVersion": { "const": "1" },
    "lockPath": { "type": "string", "minLength": 1 },
    "requiredLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "residentSampleCount": { "type": "integer", "minimum": 128 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "resourceId",
        "languageId",
        "providerId",
        "search",
        "query",
        "zeroMatchTerms",
        "requiredTelemetryEvents"
      ],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "languageId": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "terms", "view", "minimumCandidates", "maximumResidentMicros"],
          "properties": {
            "method": { "const": "lexical" },
            "terms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "view": { "const": "seeds" },
            "minimumCandidates": { "type": "integer", "minimum": 1 },
            "maximumResidentMicros": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selectorStrategy", "ownerView", "projectionScope", "maximumResidentMicros"],
          "properties": {
            "selectorStrategy": { "const": "first-ranked-parser-owned" },
            "ownerView": { "const": "items" },
            "projectionScope": { "const": "live-corpus" },
            "maximumResidentMicros": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "zeroMatchTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredTelemetryEvents": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "runtime_resident_search_terminal",
              "runtime_exact_projection_terminal"
            ]
          }
        }
      }
    }
  }
}
