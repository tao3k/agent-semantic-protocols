{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.github.io/agent-semantic-protocols/schemas/runtime-server-workspace-generation-durability.v1.schema.json",
  "title": "Runtime Server workspace generation durability receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "workspaceIdentity",
    "generationDigest",
    "targetEpoch",
    "state",
    "failure"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.runtime-server-workspace-generation-durability.v1"
    },
    "schemaVersion": { "const": "1" },
    "workspaceIdentity": { "type": "string", "minLength": 1 },
    "generationDigest": { "type": "string", "minLength": 1 },
    "targetEpoch": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": ["resident-ready", "durable-ready", "failed"]
    },
    "failure": { "type": ["string", "null"] }
  }
}
