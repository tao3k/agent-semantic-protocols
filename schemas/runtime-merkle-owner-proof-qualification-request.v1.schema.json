{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/runtime-merkle-owner-proof-qualification-request.v1.schema.json",
  "title": "Runtime Merkle Owner Proof Qualification Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "projectRoot", "ownerPaths", "caseId", "resourceId", "languageId", "providerId"],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.runtime-merkle-owner-proof-qualification-request"},
    "schemaVersion": {"const": "1"},
    "projectRoot": {"type": "string", "minLength": 1},
    "ownerPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
    "caseId": {"type": "string", "minLength": 1},
    "resourceId": {"type": "string", "minLength": 1},
    "languageId": {"type": "string", "minLength": 1},
    "providerId": {"type": "string", "minLength": 1}
  }
}
