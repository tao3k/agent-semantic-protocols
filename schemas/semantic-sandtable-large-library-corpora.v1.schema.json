{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/semantic-sandtable-large-library-corpora.v1.schema.json",
  "title": "Large library runtime benchmark corpora",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "corpora"],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.semantic-sandtable-large-library-corpora"
    },
    "schemaVersion": { "const": "1" },
    "corpora": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/corpus" }
    }
  },
  "$defs": {
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "scenarioId",
        "providerId",
        "language",
        "repository",
        "git",
        "directory",
        "environment",
        "inputs"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "scenarioId": { "type": "string", "minLength": 1 },
        "providerId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "language": {
          "enum": [
            "gerbil-scheme",
            "julia",
            "md",
            "org",
            "python",
            "rust",
            "typescript"
          ]
        },
        "repository": { "type": "string", "minLength": 1 },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["remote", "revision"],
          "properties": {
            "remote": {
              "type": "string",
              "pattern": "^\\S+$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "directory": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "environment": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extensionAuthority",
            "minimumMatchingFiles",
            "minimumMatchingFileRatio"
          ],
          "properties": {
            "extensionAuthority": {
              "const": "provider-workspace-scope"
            },
            "minimumMatchingFiles": {
              "type": "integer",
              "minimum": 1
            },
            "minimumMatchingFileRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "query", "dependency"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "query": { "type": "string", "minLength": 1 },
            "dependency": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "language": {
                "enum": ["md", "org"]
              }
            },
            "required": ["language"]
          },
          "then": {
            "required": ["admission"]
          }
        }
      ]
    }
  }
}
