{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/turso-resident-memory-search-receipt.v1.schema.json",
  "title": "Turso Resident Memory Search Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "workspaceIdentity",
    "generationDigest",
    "compileReceipt",
    "bootstrapReceipt",
    "runtimeReceipt"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.turso-resident-memory-search-receipt"
    },
    "schemaVersion": {
      "const": "1"
    },
    "workspaceIdentity": {
      "type": "string",
      "minLength": 1
    },
    "generationDigest": {
      "$ref": "#/$defs/digest"
    },
    "compileReceipt": {
      "$ref": "#/$defs/compileReceipt"
    },
    "bootstrapReceipt": {
      "$ref": "#/$defs/bootstrapReceipt"
    },
    "runtimeReceipt": {
      "$ref": "#/$defs/runtimeReceipt"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactDigest",
        "elapsedMicros",
        "crateCount"
      ],
      "properties": {
        "artifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "elapsedMicros": {
          "type": "integer",
          "minimum": 0
        },
        "crateCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bootstrapReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsedMicros",
        "databaseOpens",
        "schemaBootstraps",
        "preparedStatements",
        "generationBindings"
      ],
      "properties": {
        "elapsedMicros": {
          "type": "integer",
          "minimum": 0
        },
        "databaseOpens": {
          "const": 1
        },
        "schemaBootstraps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "preparedStatements": {
          "type": "integer",
          "minimum": 1
        },
        "generationBindings": {
          "const": 1
        }
      }
    },
    "runtimeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "elapsedNanos",
        "databaseOpens",
        "schemaBootstraps",
        "manifestWrites",
        "providerProcesses",
        "sourceScans",
        "resultCount"
      ],
      "properties": {
        "route": {
          "enum": [
            "exact-selector",
            "fts",
            "vector",
            "graph"
          ]
        },
        "elapsedNanos": {
          "type": "integer",
          "minimum": 0
        },
        "databaseOpens": {
          "const": 0
        },
        "schemaBootstraps": {
          "const": 0
        },
        "manifestWrites": {
          "const": 0
        },
        "providerProcesses": {
          "const": 0
        },
        "sourceScans": {
          "const": 0
        },
        "resultCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
