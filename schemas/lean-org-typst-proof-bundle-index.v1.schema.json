{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/lean-org-typst-proof-bundle-index.v1.schema.json",
  "title": "Lean Org Typst Proof Bundle Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "enforcedLeanGlobs", "bundles"],
  "properties": {
    "schemaId": {"const": "asp.lean-org-typst-proof-bundle-index.v1"},
    "schemaVersion": {"const": "1"},
    "enforcedLeanGlobs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundleId", "leanPath", "orgPath", "minimumTypstBlocks"],
        "properties": {
          "bundleId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
          "leanPath": {"type": "string", "pattern": "^packages/proofs/.+\\.lean$"},
          "orgPath": {"type": "string", "pattern": "^docs/.+\\.org$"},
          "minimumTypstBlocks": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
