{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tao3k.dev/schemas/provider-relation-generation.v1.schema.json",
  "title": "Provider Relation Generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "generationDigest", "relations"],
  "properties": {
    "schemaId": { "const": "asp.provider-relation-generation.v1" },
    "schemaVersion": { "const": "1" },
    "generationDigest": {
      "type": "string",
      "pattern": "^blake3-256:[0-9a-f]{64}$"
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "relation": {
      "$ref": "provider-definitions.v1.schema.json#/$defs/relation"
    }
  }
}
