{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/client-storage-definitions.v1.schema.json",
  "title": "Client Storage Shared Definitions v1",
  "type": "object",
  "$defs": {
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoId",
        "workspaceId",
        "scopeId",
        "sessionId",
        "agentId"
      ],
      "properties": {
        "repoId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "scopeId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleCount",
        "p50",
        "p95",
        "p99",
        "max"
      ],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "p50": { "type": "integer", "minimum": 0 },
        "p95": { "type": "integer", "minimum": 0 },
        "p99": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
