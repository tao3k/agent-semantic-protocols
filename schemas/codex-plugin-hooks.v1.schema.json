{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/codex-plugin-hooks.v1.schema.json",
  "title": "ASP Codex Plugin Hooks",
  "description": "Closed v1 contract for the Codex plugin hook entrypoints installed by ASP.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hooks"],
  "properties": {
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SessionStart",
        "UserPromptSubmit",
        "PreToolUse",
        "PermissionRequest",
        "PostToolUse",
        "SubagentStart",
        "SubagentStop",
        "Stop"
      ],
      "properties": {
        "SessionStart": {
          "$ref": "#/$defs/sessionStart"
        },
        "UserPromptSubmit": {
          "$ref": "#/$defs/userPrompt"
        },
        "PreToolUse": {
          "$ref": "#/$defs/preTool"
        },
        "PermissionRequest": {
          "$ref": "#/$defs/permissionRequest"
        },
        "PostToolUse": {
          "$ref": "#/$defs/postTool"
        },
        "SubagentStart": {
          "$ref": "#/$defs/subagentStart"
        },
        "SubagentStop": {
          "$ref": "#/$defs/subagentStop"
        },
        "Stop": {
          "$ref": "#/$defs/stop"
        }
      }
    }
  },
  "$defs": {
    "commandHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command"],
      "properties": {
        "type": {
          "const": "command"
        },
        "command": {
          "type": "string"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "statusMessage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hooks"],
      "properties": {
        "matcher": {
          "type": "string"
        },
        "hooks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/commandHook"
          }
        }
      }
    },
    "sessionStart": {
      "$ref": "#/$defs/eventHandlers",
      "items": {
        "$ref": "#/$defs/handler",
        "properties": {
          "hooks": {
            "items": {
              "properties": {
                "command": {
                  "const": "asp hook session-start --client codex"
                }
              }
            }
          }
        }
      }
    },
    "userPrompt": {
      "$ref": "#/$defs/eventHandlers",
      "items": {
        "$ref": "#/$defs/handler",
        "properties": {
          "hooks": {
            "items": {
              "properties": {
                "command": {
                  "const": "asp hook user-prompt --client codex"
                }
              }
            }
          }
        }
      }
    },
    "preTool": {
      "$ref": "#/$defs/eventHandlers",
      "items": {
        "$ref": "#/$defs/handler",
        "properties": {
          "hooks": {
            "items": {
              "properties": {
                "command": {
                  "const": "asp hook pre-tool --client codex"
                }
              }
            }
          }
        }
      }
    },
    "permissionRequest": {
      "$ref": "#/$defs/eventHandlers",
      "items": {
        "$ref": "#/$defs/handler",
        "properties": {
          "hooks": {
            "items": {
              "properties": {
                "command": {
                  "const": "asp hook permission-request --client codex"
                }
              }
            }
          }
        }
      }
    },
    "postTool": {
      "$ref": "#/$defs/eventHandlers",
      "items": {
        "$ref": "#/$defs/handler",
        "properties": {
          "hooks": {
            "items": {
              "properties": {
                "command": {
                  "const": "asp hook post-tool --client codex"
                }
              }
            }
          }
        }
      }
    },
    "subagentStart": {
      "$ref": "#/$defs/eventHandlers",
      "items": {
        "$ref": "#/$defs/handler",
        "properties": {
          "hooks": {
            "items": {
              "properties": {
                "command": {
                  "const": "asp hook subagent-start --client codex"
                }
              }
            }
          }
        }
      }
    },
    "subagentStop": {
      "$ref": "#/$defs/eventHandlers",
      "items": {
        "$ref": "#/$defs/handler",
        "properties": {
          "hooks": {
            "items": {
              "properties": {
                "command": {
                  "const": "asp hook subagent-stop --client codex"
                }
              }
            }
          }
        }
      }
    },
    "stop": {
      "$ref": "#/$defs/eventHandlers",
      "items": {
        "$ref": "#/$defs/handler",
        "properties": {
          "hooks": {
            "items": {
              "properties": {
                "command": {
                  "const": "asp hook stop --client codex"
                }
              }
            }
          }
        }
      }
    },
    "eventHandlers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    }
  }
}
