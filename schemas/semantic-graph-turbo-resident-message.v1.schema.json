{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/semantic-graph-turbo-resident-message.v1.schema.json",
  "title": "ASP multiplexed resident Graph Turbo message",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "protocolId", "protocolVersion", "messageKind", "requestId"],
  "properties": {
    "schemaId": {"const": "agent.semantic-protocols.semantic-graph-turbo-resident-message"},
    "schemaVersion": {"const": "1"},
    "protocolId": {"const": "agent.semantic-protocols.semantic-language"},
    "protocolVersion": {"const": "1"},
    "messageKind": {"enum": ["process-handshake", "rank", "shutdown"]},
    "requestId": {"type": "string", "minLength": 1},
    "runtimeArtifactDigest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"},
    "executionCommandDigest": {"type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$"},
    "sessionId": {"type": "string", "minLength": 1},
    "nodeId": {"type": "string", "minLength": 1},
    "snapshotDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspaceGenerationRootDigest": {"type": "string", "minLength": 1},
    "routeId": {"type": "string", "minLength": 1},
    "request": {"$ref": "https://agent-semantic-protocols.local/schemas/semantic-graph-turbo-request.v1.schema.json"}
  },
  "allOf": [
    {
      "if": {"properties": {"messageKind": {"const": "process-handshake"}}, "required": ["messageKind"]},
      "then": {
        "required": ["runtimeArtifactDigest", "executionCommandDigest"],
        "not": {
          "anyOf": [
            {"required": ["sessionId"]},
            {"required": ["nodeId"]},
            {"required": ["snapshotDigest"]},
            {"required": ["workspaceGenerationRootDigest"]},
            {"required": ["routeId"]},
            {"required": ["request"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"messageKind": {"const": "rank"}}, "required": ["messageKind"]},
      "then": {"required": ["sessionId", "nodeId", "snapshotDigest", "workspaceGenerationRootDigest", "routeId", "request"]}
    }
  ]
}
