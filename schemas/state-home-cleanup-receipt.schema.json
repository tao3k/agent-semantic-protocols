{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.semantic.protocols/schemas/state-home-cleanup-receipt",
  "title": "ASP State Home Cleanup Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "state",
    "retainedForDays",
    "catalogGeneration",
    "canonicalWorkspacesDeleted",
    "workspaceTopology",
    "catalogPlan"
  ],
  "properties": {
    "schemaId": { "const": "agent.semantic-protocols.state-home-cleanup-receipt" },
    "schemaVersion": { "const": 1 },
    "state": { "const": "applied" },
    "retainedForDays": { "type": "integer", "minimum": 1 },
    "catalogGeneration": { "type": "integer", "minimum": 0 },
    "canonicalWorkspacesDeleted": { "type": "integer", "minimum": 0 },
    "workspaceTopology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId",
          "repositoryDigest",
          "workspaceDigest",
          "canonicalRoot",
          "state",
          "reason"
        ],
        "properties": {
          "objectId": { "type": "string", "minLength": 1 },
          "repositoryDigest": { "type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$" },
          "workspaceDigest": { "type": "string", "pattern": "^blake3-256:[0-9a-f]{64}$" },
          "canonicalRoot": { "type": "string", "minLength": 1 },
          "state": {
            "enum": ["reachable", "missing", "identity-mismatch", "unverifiable"]
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "catalogPlan": {
      "type": "object",
      "required": [
        "schemaId",
        "schemaVersion",
        "evaluatedAtMs",
        "retainForMs",
        "retainedCount",
        "deletedCount",
        "retainedBytes",
        "deletedBytes",
        "entries"
      ],
      "properties": {
        "schemaId": { "const": "agent.semantic-protocols.state-home-retention-plan" },
        "schemaVersion": { "const": 1 }
      }
    }
  }
}
