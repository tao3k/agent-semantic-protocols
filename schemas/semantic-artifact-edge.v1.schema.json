{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/semantic-artifact-edge.v1.schema.json",
  "title": "ASP Merkle artifact edge v1",
  "description": "Queryable edge between two artifact roots in the Merkle artifact forest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "edgeHash",
    "role",
    "ordinal",
    "parent",
    "child"
  ],
  "properties": {
    "schemaId": {
      "const": "semantic-artifact-edge"
    },
    "schemaVersion": {
      "const": "1"
    },
    "edgeHash": {
      "$ref": "#/$defs/artifactHash"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "parent": {
      "$ref": "#/$defs/artifactRootRef"
    },
    "child": {
      "$ref": "#/$defs/artifactRootRef"
    }
  },
  "$defs": {
    "artifactHash": {
      "$ref": "semantic-artifact-definitions.v1.schema.json#/$defs/artifactHash"
    },
    "artifactRootRef": {
      "$ref": "semantic-artifact-definitions.v1.schema.json#/$defs/artifactRootRef"
    }
  }
}
