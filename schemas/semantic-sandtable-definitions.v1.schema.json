{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.local/schemas/semantic-sandtable-definitions.v1.schema.json",
  "title": "Semantic Sandtable Family Definitions v1",
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string"}
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "queryScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectRoot": {"type": "string", "minLength": 1},
        "packageName": {"type": "string", "minLength": 1},
        "ownerPath": {"type": "string", "minLength": 1},
        "roots": {"$ref": "#/$defs/stringList"}
      }
    },
    "querySetOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "queries", "saveCommands"],
      "properties": {
        "view": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "queries": {"type": "integer", "minimum": 2},
        "saveCommands": {"type": "integer", "minimum": 1},
        "selector": {"enum": ["exact-set", "prefix-set", "stdin-path-set"]},
        "reason": {"type": "string", "minLength": 1},
        "terms": {"$ref": "#/$defs/stringList"},
        "scope": {"$ref": "#/$defs/queryScope"},
        "beforeCommandIds": {"$ref": "#/$defs/stringList"},
        "recommendedCommand": {"$ref": "#/$defs/argv"}
      }
    },
    "evidenceFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "failureFrontierEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "path", "line", "column"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "message": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "repair": {"type": "string", "minLength": 1},
        "hotBlockSelector": {"type": "string", "minLength": 1},
        "hotBlockReason": {"type": "string", "minLength": 1},
        "nextAction": {"type": "string", "minLength": 1},
        "nextSelector": {"type": "string", "minLength": 1},
        "nextRoot": {"type": "string", "minLength": 1}
      }
    },
    "coverageList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "language-registry",
          "json-schema",
          "search-flow",
          "deps-query",
          "policy-blackbox",
          "policy-whitebox",
          "performance",
          "security",
          "codex-hooks",
          "codex-wrapper",
          "evidence-assurance",
          "desktop-hooks",
          "cli-hooks",
          "real-trigger",
          "large-library"
        ]
      }
    }
  }
}
