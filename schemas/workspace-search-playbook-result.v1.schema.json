{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/workspace-search-playbook-result.v1.schema.json",
  "title": "Workspace Search Playbook Result V1",
  "description": "Save-token Search result projected after every Agent-authored acquisition clause and requested Graph fan-in completes. Evidence exposes exact Query affordances without source, audit digests, or a prescribed next action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "result", "evidence"],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.workspace-search-playbook-result"
    },
    "schemaVersion": {
      "const": "1"
    },
    "result": {
      "enum": [
        "exact-selector-ready",
        "disambiguation-required",
        "relationship-supported",
        "no-match",
        "contradiction",
        "refinement-required",
        "provider-contract-failure"
      ]
    },
    "queryGrammar": {
      "const": "asp query --selector <exact-selector> --projection <callable-skeleton|source>"
    },
    "evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/selectorEvidence"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence": {"minItems": 1}},
        "required": ["evidence"]
      },
      "then": {"required": ["queryGrammar"]}
    },
    {
      "if": {
        "properties": {"evidence": {"maxItems": 0}},
        "required": ["evidence"]
      },
      "then": {"not": {"required": ["queryGrammar"]}}
    }
  ],
  "$defs": {
    "selectorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "item", "selector", "matchedBy", "relation"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*://.+#item/.+$"
        },
        "matchedBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 69,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(fd|rg|tantivy|syntax|graph):[0-9]+$"
          }
        },
        "relation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
