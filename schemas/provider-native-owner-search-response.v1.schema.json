{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-semantic-protocols.dev/schemas/provider-native-owner-search-response.v1.schema.json",
  "title": "ASP Provider Native Owner Search Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "languageId",
    "providerId",
    "requestedOwnerPath",
    "requestedProjectionMode",
    "sourceContentDigest",
    "parsedOwnerCount",
    "projectionCompleteness",
    "projections"
  ],
  "properties": {
    "schemaId": {
      "const": "agent.semantic-protocols.provider-native-owner-search-response"
    },
    "schemaVersion": {
      "const": "1"
    },
    "languageId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "requestedOwnerPath": {
      "type": "string",
      "minLength": 1
    },
    "requestedProjectionMode": {
      "const": "complete-owner"
    },
    "sourceContentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parsedOwnerCount": {
      "const": 1
    },
    "projectionCompleteness": {
      "const": "complete-owner"
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonicalItemSelector",
          "signature",
          "captureName",
          "sourceByteStart",
          "sourceByteEnd"
        ],
        "properties": {
          "canonicalItemSelector": {
            "$ref": "https://agent-semantic-protocols.dev/schemas/canonical-item-selector.v1.schema.json"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "captureName": {
            "type": "string",
            "minLength": 1
          },
          "sourceByteStart": {
            "type": "integer",
            "minimum": 0
          },
          "sourceByteEnd": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
