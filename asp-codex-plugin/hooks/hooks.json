{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" session-start --client codex",
            "timeout": 1,
            "statusMessage": "Loading Agent Semantic Protocol activation"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" user-prompt --client codex",
            "timeout": 1,
            "statusMessage": "Planning Agent Semantic Protocol search flow"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match apply_patch",
            "timeout": 1,
            "statusMessage": "Checking Agent Semantic Protocol edit policy"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match Bash",
            "timeout": 1,
            "statusMessage": "Checking Agent Semantic Protocol command policy"
          }
        ]
      },
      {
        "matcher": "spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match spawn_agent",
            "timeout": 1,
            "statusMessage": "Checking Agent Semantic Protocol agent policy"
          }
        ]
      },
      {
        "matcher": "mcp__codex_app__automation_update",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__automation_update", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol Host control policy" }]
      },
      {
        "matcher": "mcp__codex_app__create_thread",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__create_thread", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__fork_thread",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__fork_thread", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__list_threads",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__list_threads", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__list_projects",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__list_projects", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol workspace policy" }]
      },
      {
        "matcher": "mcp__codex_app__list_archived_threads",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__list_archived_threads", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__read_thread",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__read_thread", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__read_thread_terminal",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__read_thread_terminal", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__load_workspace_dependencies",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__load_workspace_dependencies", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol workspace policy" }]
      },
      {
        "matcher": "mcp__codex_app__send_message_to_thread",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__send_message_to_thread", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__wait_threads",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__wait_threads", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__handoff_thread",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__handoff_thread", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__get_handoff_status",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__get_handoff_status", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__navigate_to_codex_page",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__navigate_to_codex_page", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__open_in_codex",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__open_in_codex", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__set_thread_archived",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__set_thread_archived", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__set_thread_pinned",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__set_thread_pinned", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__set_thread_title",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__set_thread_title", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      },
      {
        "matcher": "mcp__codex_app__share_thread",
        "hooks": [{ "type": "command", "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" pre-tool --client codex --host-match mcp__codex_app__share_thread", "timeout": 1, "statusMessage": "Checking Agent Semantic Protocol thread policy" }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" post-tool --client codex",
            "timeout": 1,
            "statusMessage": "Updating Agent Semantic Protocol search state"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" subagent-start --client codex",
            "timeout": 1,
            "statusMessage": "Observing Agent Semantic Protocol subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" subagent-stop --client codex",
            "timeout": 1,
            "statusMessage": "Observing Agent Semantic Protocol subagent stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/asp-hook-exec\" stop --client codex",
            "timeout": 1,
            "statusMessage": "Checking Agent Semantic Protocol changed files"
          }
        ]
      }
    ]
  }
}
