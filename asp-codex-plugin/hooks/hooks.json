{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
          "command": "asp hook session-start --client codex",
            "timeout": 1,
            "statusMessage": "Loading Agent Semantic Protocol activation"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "asp hook user-prompt --client codex",
            "timeout": 1,
            "statusMessage": "Planning Agent Semantic Protocol search flow"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
          "command": "asp hook pre-tool --client codex",
            "timeout": 1,
            "statusMessage": "Checking Agent Semantic Protocol search policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
      "matcher": "*",
        "hooks": [
          {
            "type": "command",
          "command": "asp hook permission-request --client codex",
            "timeout": 1,
            "statusMessage": "Checking Agent Semantic Protocol approval policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "asp hook post-tool --client codex",
            "timeout": 1,
            "statusMessage": "Updating Agent Semantic Protocol search state"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "asp hook subagent-start --client codex",
            "timeout": 1,
            "statusMessage": "Preparing Agent Semantic Protocol subagent context"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "asp hook subagent-stop --client codex",
            "timeout": 1,
            "statusMessage": "Checking Agent Semantic Protocol subagent evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
          "command": "asp hook stop --client codex",
            "timeout": 1,
            "statusMessage": "Checking Agent Semantic Protocol changed files"
          }
        ]
      }
    ]
  }
}
