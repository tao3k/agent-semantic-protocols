#!/bin/sh

# Stable plugin-owned bootstrap for the one-shot ASP Hook evaluator.
# Codex runs plugin hooks from the session cwd and does not guarantee that the
# user's interactive PATH is present. Resolve the canonical runtime artifact
# directly; never contact or start ASP Runtime Server from this launcher.

set -u

event="${1:-unknown}"
state_home="${ASP_STATE_HOME:-${HOME:-}/.agent-semantic-protocols}"
runtime_bin="${state_home}/runtime/bin/asp"

emit_unavailable() {
  detail="$1"
  reason="ASP Hook evaluator is unavailable (${detail}). Publish a verified ASP artifact with: asp install binary"
  case "$event" in
    pre-tool)
      printf '%s\n' "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"${reason}\"},\"systemMessage\":\"${reason}\"}"
      ;;
    permission-request)
      printf '%s\n' "{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"deny\",\"message\":\"${reason}\"}},\"systemMessage\":\"${reason}\"}"
      ;;
    *)
      printf '%s\n' "{\"systemMessage\":\"${reason}\"}"
      ;;
  esac
}

if [ -f "$runtime_bin" ] && [ -x "$runtime_bin" ]; then
  ASP_HOOK_LAUNCHER_BINARY="$runtime_bin"
  ASP_HOOK_LAUNCHER_PATH="$0"
  ASP_HOOK_LAUNCHER_STATE_HOME="$state_home"
  export ASP_HOOK_LAUNCHER_BINARY ASP_HOOK_LAUNCHER_PATH ASP_HOOK_LAUNCHER_STATE_HOME
  exec "$runtime_bin" hook "$@"
fi

emit_unavailable "canonical runtime artifact is missing or non-executable"
exit 0
