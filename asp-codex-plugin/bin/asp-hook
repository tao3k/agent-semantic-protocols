#!/bin/sh
set -eu

asp_hook_state_home=${ASP_STATE_HOME:-${HOME}/.agent-semantic-protocols}

asp_hook_generation_unavailable() {
    asp_hook_reason='ASP Hook binary is unavailable (HookGeneration current is missing or its asp-hook is non-executable). Publish a verified ASP artifact with: asp install binary'
    case "${1:-}" in
        pre-tool)
            printf '%s\n' "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"$asp_hook_reason\"},\"systemMessage\":\"$asp_hook_reason\"}"
            ;;
        *)
            printf '%s\n' "{\"systemMessage\":\"$asp_hook_reason\"}"
            ;;
    esac
}

if [ "${ASP_NO_AGENT:-}" = "1" ]; then
    printf '%s\n' '{}'
    exit 0
fi

if ! asp_hook_generation_root=$(CDPATH= cd -P -- "$asp_hook_state_home/hooks/current" 2>/dev/null && pwd -P); then
    asp_hook_generation_unavailable "${1:-}"
    exit 0
fi
hook_bin="$asp_hook_generation_root/asp-hook"
export ASP_HOOK_GENERATION_ROOT="$asp_hook_generation_root"
asp_hook_generation_name=${asp_hook_generation_root##*/}
export ASP_HOOK_GENERATION_DIGEST="blake3-256:$asp_hook_generation_name"

if [ ! -x "$hook_bin" ]; then
    asp_hook_generation_unavailable "${1:-}"
    exit 0
fi
exec "$hook_bin" hook "$@"
