{
  "id": "julia.flux-intent-matrix",
  "language": "julia",
  "title": "Flux.jl large-library feature/API/principle intent matrix",
  "coverage": [
    "search-flow",
    "performance",
    "large-library"
  ],
  "tags": [
    "large-library",
    "flux",
    "intent-matrix"
  ],
  "evidence": {
    "source": "handwritten",
    "fixtureTier": "large-library",
    "targetLibrary": {
      "language": "julia",
      "name": "Flux.jl",
      "package": "Flux",
      "repository": "FluxML/Flux.jl",
      "workdirKind": "registry"
    },
    "intentCases": [
      {
        "intentKind": "feature-implementation",
        "intent": "Find training loop owners from compact seeds",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "train"
        ]
      },
      {
        "intentKind": "api-usage",
        "intent": "Find Chain API exposure and examples",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "Chain"
        ]
      },
      {
        "intentKind": "implementation-principle",
        "intent": "Understand gradient and parameter flow without reading the whole package",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "gradient"
        ]
      }
    ]
  },
  "workdir": {
    "env": "SANDTABLE_JULIA_FLUX_ROOT",
    "candidates": [
      "~/.julia/packages/Flux/*"
    ]
  },
  "warmup": [
    {
      "id": "julia-warmup",
      "command": [
        "asp",
        "julia",
        "search",
        "prime",
        "--view",
        "seeds",
        "--workspace",
        "."
      ],
      "timeoutSeconds": 30
    }
  ],
  "budgets": {
    "maxCommands": 2,
    "maxTotalLinesWarn": 24,
    "maxTotalStdoutBytesWarn": 16000
  },
  "steps": [
    {
      "id": "prime",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "julia",
        "--rg",
        "-n",
        "-e",
        "julia|source",
        ".",
        "--tantivy",
        "title:\"julia\"^2 OR body:\"source\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(julia:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "|seed",
          "|synthesis",
          "G=search:result!query",
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "intent-query-set",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "julia",
        "--rg",
        "-n",
        "-e",
        "train|Chain|gradient",
        ".",
        "--tantivy",
        "title:\"train\"^2 OR body:\"Chain\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(julia:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "|seed",
          "|synthesis",
          "G=search:result!query",
          "MaterializationSet"
        ]
      }
    }
  ]
}
