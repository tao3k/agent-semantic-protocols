{
  "id": "julia.dataframes-intent-matrix",
  "language": "julia",
  "title": "DataFrames.jl large-library feature/API/principle intent matrix",
  "coverage": [
    "search-flow",
    "performance",
    "large-library"
  ],
  "tags": [
    "large-library",
    "dataframes",
    "intent-matrix"
  ],
  "evidence": {
    "source": "handwritten",
    "fixtureTier": "large-library",
    "targetLibrary": {
      "language": "julia",
      "name": "DataFrames.jl",
      "package": "DataFrames",
      "repository": "JuliaData/DataFrames.jl",
      "workdirKind": "registry"
    },
    "intentCases": [
      {
        "intentKind": "feature-implementation",
        "intent": "Implement or inspect grouped data behavior from compact owner seeds",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "groupby"
        ]
      },
      {
        "intentKind": "api-usage",
        "intent": "Find how DataFrame is exposed and used",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "DataFrame"
        ]
      },
      {
        "intentKind": "implementation-principle",
        "intent": "Understand transform/combine implementation principles without reading the whole package",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "transform"
        ]
      }
    ]
  },
  "workdir": {
    "env": "SANDTABLE_JULIA_DATAFRAMES_ROOT",
    "candidates": [
      "~/.julia/packages/DataFrames/*"
    ]
  },
  "budgets": {
    "maxCommands": 4,
    "maxTotalLinesWarn": 42,
    "maxTotalStdoutBytesWarn": 24000
  },
  "steps": [
    {
      "id": "prime",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "julia",
        "--rg",
        "-n",
        "-e",
        "julia|source",
        ".",
        "--tantivy",
        "title:\"julia\"^2 OR body:\"source\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(julia:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "|seed",
          "|synthesis",
          "G=search:result!query",
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "owner-dataframes",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "julia",
        "--rg",
        "-n",
        "-e",
        "DataFrames",
        "src/DataFrames.jl",
        "--tantivy",
        "title:\"DataFrames\"^2 OR body:\"DataFrames\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(julia:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "|seed",
          "|synthesis",
          "G=search:result!query",
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "deps-tables",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "julia",
        "--rg",
        "-n",
        "-e",
        "Tables",
        ".",
        "--tantivy",
        "title:\"Tables\"^2 OR body:\"Tables\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(julia:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "|seed",
          "|synthesis",
          "G=search:result!query",
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "intent-query-set",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "julia",
        "--rg",
        "-n",
        "-e",
        "groupby|DataFrame|transform",
        ".",
        "--tantivy",
        "title:\"groupby\"^2 OR body:\"DataFrame\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(julia:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "|seed",
          "|synthesis",
          "G=search:result!query",
          "MaterializationSet"
        ]
      }
    }
  ],
  "warmup": [
    {
      "id": "julia-warmup",
      "command": [
        "asp",
        "julia",
        "search",
        "prime",
        "--view",
        "seeds",
        "--workspace",
        "."
      ],
      "timeoutSeconds": 30
    }
  ]
}
