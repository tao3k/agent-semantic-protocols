{
  "id": "julia.makie-intent-matrix",
  "language": "julia",
  "title": "Makie.jl large-library feature/API/principle intent matrix",
  "coverage": [
    "search-flow",
    "performance",
    "large-library"
  ],
  "tags": [
    "large-library",
    "makie",
    "intent-matrix"
  ],
  "evidence": {
    "source": "handwritten",
    "fixtureTier": "large-library",
    "targetLibrary": {
      "language": "julia",
      "name": "Makie.jl",
      "package": "Makie",
      "repository": "MakieOrg/Makie.jl",
      "workdirKind": "registry"
    },
    "intentCases": [
      {
        "intentKind": "feature-implementation",
        "intent": "Find plot pipeline owners from compact seeds",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "plot"
        ]
      },
      {
        "intentKind": "api-usage",
        "intent": "Find Figure API exposure and examples",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "Figure"
        ]
      },
      {
        "intentKind": "implementation-principle",
        "intent": "Understand Axis/layout implementation principles without reading the whole package",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "Axis"
        ]
      }
    ]
  },
  "workdir": {
    "env": "SANDTABLE_JULIA_MAKIE_ROOT",
    "candidates": [
      "~/.julia/packages/Makie/*"
    ]
  },
  "budgets": {
    "maxCommands": 2,
    "maxTotalLinesWarn": 24,
    "maxTotalStdoutBytesWarn": 16000
  },
  "steps": [
    {
      "id": "prime",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "julia",
        "--rg",
        "-n",
        "-e",
        "julia|source",
        ".",
        "--tantivy",
        "title:\"julia\"^2 OR body:\"source\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(julia:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "|seed",
          "|synthesis",
          "G=search:result!query",
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "intent-query-set",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "julia",
        "--rg",
        "-n",
        "-e",
        "plot|Figure|Axis",
        ".",
        "--tantivy",
        "title:\"plot\"^2 OR body:\"Figure\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(julia:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "|seed",
          "|synthesis",
          "G=search:result!query",
          "MaterializationSet"
        ]
      }
    }
  ]
}
