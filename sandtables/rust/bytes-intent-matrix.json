  "steps": [
    {
      "id": "prime",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "rust",
        "--rg",
        "-n",
        "-e",
        "rust|source",
        ".",
        "--tantivy",
        "title:\"rust\"^2 OR body:\"source\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(rust:Language)-[:RESULTS]->[",
          "#+end_src"
