{
  "id": "typescript.vite-intent-matrix",
  "language": "typescript",
  "title": "Vite large-library feature/API/principle intent matrix",
  "coverage": [
    "search-flow",
    "performance",
    "large-library"
  ],
  "tags": [
    "large-library",
    "vite",
    "intent-matrix"
  ],
  "evidence": {
    "source": "handwritten",
    "fixtureTier": "large-library",
    "targetLibrary": {
      "language": "typescript",
      "name": "Vite",
      "package": "vite",
      "repository": "vitejs/vite",
      "workdirKind": "checkout"
    },
    "intentCases": [
      {
        "intentKind": "feature-implementation",
        "intent": "Implement a dev-server HMR feature after locating compact owners and tests",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "handleHotUpdate"
        ]
      },
      {
        "intentKind": "api-usage",
        "intent": "Find createServer API usage and public surface owners",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "createServer"
        ]
      },
      {
        "intentKind": "implementation-principle",
        "intent": "Understand plugin container execution flow from search packets",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "pluginContainer"
        ]
      }
    ],
    "deepQuestionCases": [
      {
        "id": "vite-plugin-container-hmr-owner-flow",
        "question": "In Vite, which plugin container, handleHotUpdate, and module graph owners should an agent inspect before changing HMR invalidation behavior?",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "pluginContainer",
          "handleHotUpdate",
          "moduleGraph"
        ],
        "audit": {
          "maxAspCommands": 7,
          "maxSearchCommands": 4,
          "maxQueryCommands": 3,
          "maxRepeatedCommands": 0,
          "requiresGraphSignals": true,
          "requiresQuerySet": true,
          "requiresHookEvents": true
        },
        "expectedAspFlow": {
          "requiredStages": [
            "search-playbook",
            "query-selector"
          ],
          "forbiddenStages": [
            "repeated-commands"
          ]
        }
      },
      {
        "id": "vite-config-resolve-plugin-deep",
        "question": "In Vite, how should an agent connect config resolution, plugin container ordering, and dev server owners before changing plugin hook execution?",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "resolveConfig",
          "pluginContainer",
          "createServer"
        ],
        "audit": {
          "maxAspCommands": 7,
          "maxSearchCommands": 4,
          "maxQueryCommands": 3,
          "maxRepeatedCommands": 0,
          "requiresGraphSignals": true,
          "requiresQuerySet": true,
          "requiresHookEvents": true
        },
        "expectedAspFlow": {
          "requiredStages": [
            "search-playbook",
            "query-selector"
          ],
          "forbiddenStages": [
            "repeated-commands",
            "direct-read"
          ]
        }
      }
    ]
  },
  "workdir": {
    "env": "SANDTABLE_TS_VITE_ROOT",
    "candidates": [
      "~/ghq/github.com/vitejs/vite",
      "~/src/vite",
      "~/work/vite"
    ]
  },
  "budgets": {
    "maxCommands": 2,
    "maxTotalLinesWarn": 24,
    "maxTotalStdoutBytesWarn": 16000
  },
  "steps": [
    {
      "id": "prime",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "typescript",
        "--rg",
        "-n",
        "-e",
        "typescript|source",
        ".",
        "--tantivy",
        "title:\"typescript\"^2 OR body:\"source\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(typescript:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "intent-query-set",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "typescript",
        "--rg",
        "-n",
        "-e",
        "handleHotUpdate|createServer|pluginContainer",
        ".",
        "--tantivy",
        "title:\"handleHotUpdate\"^2 OR body:\"createServer\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(typescript:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "MaterializationSet"
        ]
      }
    }
  ]
}
