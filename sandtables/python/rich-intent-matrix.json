{
  "id": "python.rich-intent-matrix",
  "language": "python",
  "title": "Rich large-library feature/API/principle intent matrix",
  "coverage": [
    "search-flow",
    "performance",
    "large-library"
  ],
  "tags": [
    "large-library",
    "rich",
    "intent-matrix"
  ],
  "evidence": {
    "source": "handwritten",
    "fixtureTier": "large-library",
    "targetLibrary": {
      "language": "python",
      "name": "Rich",
      "package": "rich",
      "repository": "Textualize/rich",
      "workdirKind": "checkout"
    },
    "intentCases": [
      {
        "intentKind": "feature-implementation",
        "intent": "Implement a progress rendering feature after locating owners and tests",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "Progress"
        ]
      },
      {
        "intentKind": "api-usage",
        "intent": "Find Console API usage and callsites",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "Console"
        ]
      },
      {
        "intentKind": "implementation-principle",
        "intent": "Understand renderable protocol implementation paths from compact search packets",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "RenderableType"
        ]
      }
    ]
  },
  "workdir": {
    "env": "SANDTABLE_PY_RICH_ROOT",
    "candidates": [
      "~/ghq/github.com/Textualize/rich",
      "~/src/rich",
      "~/work/rich"
    ]
  },
  "budgets": {
    "maxCommands": 2,
    "maxTotalLinesWarn": 22,
    "maxTotalStdoutBytesWarn": 10000
  },
  "steps": [
    {
      "id": "prime",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "python",
        "--rg",
        "-n",
        "-e",
        "python|source",
        ".",
        "--tantivy",
        "title:\"python\"^2 OR body:\"source\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(python:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "intent-query-set",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "python",
        "--rg",
        "-n",
        "-e",
        "Progress|Console|RenderableType",
        ".",
        "--tantivy",
        "title:\"Progress\"^2 OR body:\"Console\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(python:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "MaterializationSet"
        ]
      }
    }
  ]
}
