{
  "id": "python.fastapi-intent-matrix",
  "language": "python",
  "title": "FastAPI large-library feature/API/principle intent matrix",
  "coverage": [
    "search-flow",
    "performance",
    "large-library"
  ],
  "tags": [
    "large-library",
    "fastapi",
    "intent-matrix"
  ],
  "evidence": {
    "source": "handwritten",
    "fixtureTier": "large-library",
    "targetLibrary": {
      "language": "python",
      "name": "FastAPI",
      "package": "fastapi",
      "repository": "fastapi/fastapi",
      "workdirKind": "checkout"
    },
    "intentCases": [
      {
        "intentKind": "feature-implementation",
        "intent": "Implement lifespan or startup behavior after locating compact owners and tests",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "lifespan"
        ]
      },
      {
        "intentKind": "api-usage",
        "intent": "Find APIRouter API usage and callsites",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "APIRouter"
        ]
      },
      {
        "intentKind": "implementation-principle",
        "intent": "Understand dependency solving implementation paths from parser-owned facts",
        "stepIds": [
          "prime",
          "intent-query-set"
        ],
        "queryTerms": [
          "solve_dependencies"
        ]
      }
    ]
  },
  "workdir": {
    "env": "SANDTABLE_PY_FASTAPI_ROOT",
    "candidates": [
      "~/ghq/github.com/fastapi/fastapi",
      "~/src/fastapi",
      "~/work/fastapi"
    ]
  },
  "budgets": {
    "maxCommands": 4,
    "maxTotalLinesWarn": 42,
    "maxTotalStdoutBytesWarn": 20000
  },
  "steps": [
    {
      "id": "prime",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "python",
        "--rg",
        "-n",
        "-e",
        "python|source",
        ".",
        "--tantivy",
        "title:\"python\"^2 OR body:\"source\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(python:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "owner-routing",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "python",
        "--rg",
        "-n",
        "-e",
        "routing",
        "fastapi/routing.py",
        "--tantivy",
        "title:\"routing\"^2 OR body:\"routing\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(python:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "deps-pydantic",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "python",
        "--rg",
        "-n",
        "-e",
        "pydantic",
        ".",
        "--tantivy",
        "title:\"pydantic\"^2 OR body:\"pydantic\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(python:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "MaterializationSet"
        ]
      }
    },
    {
      "id": "intent-query-set",
      "command": [
        "asp",
        "search",
        "playbook",
        "--language",
        "python",
        "--rg",
        "-n",
        "-e",
        "lifespan|APIRouter|solve_dependencies",
        ".",
        "--tantivy",
        "title:\"lifespan\"^2 OR body:\"APIRouter\""
      ],
      "expect": {
        "stdoutContains": [
          "#+begin_src gql :name result",
          "(python:Language)-[:RESULTS]->[",
          "#+end_src"
        ],
        "maxStdoutLinesWarn": 40,
        "maxElapsedMs": 90000,
        "maxElapsedMsWarn": 90000,
        "stdoutNotContains": [
          "MaterializationSet"
        ]
      }
    }
  ]
}
