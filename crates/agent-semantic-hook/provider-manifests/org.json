{
  "schemaId": "agent.semantic-protocols.hook.provider-manifest",
  "schemaVersion": "1",
  "protocolId": "agent.semantic-protocols.hook",
  "protocolVersion": "1",
  "manifestId": "agent.semantic-protocols.providers.org.orgize",
  "manifestVersion": "0.1.0",
  "languageId": "org",
  "providerId": "orgize",
  "namespace": "agent.semantic-protocols.languages.org.orgize",
  "binary": "orgize",
  "execution": "external-process",
  "source": {
    "defaultExtensions": [
      ".org",
      ".org_archive"
    ],
    "defaultSourceRoots": [
      "docs"
    ],
    "defaultProjectMarkers": [],
    "defaultDependencyMarkers": [],
    "defaultConfigFiles": [],
    "defaultIgnoredPathPrefixes": [
      "target",
      ".cache",
      ".codex/harness-state",
      ".codex/rs-harness",
      ".data",
      ".devenv",
      ".direnv",
      ".git",
      ".idea",
      ".jj",
      ".run",
      ".vscode",
      "node_modules"
    ]
  },
  "searchCapabilities": {
    "dependencyTopology": false,
    "dependencyTopologyMetadata": false,
    "ownerItems": true,
    "semanticFacts": false,
    "workspaceScope": false,
    "sourceSnapshot": {
      "descriptorId": "org.source-snapshot",
      "descriptorVersion": "1",
      "languageId": "org",
      "authority": "live-parser",
      "algorithm": "blake3-merkle-v1",
      "overlayMode": "merkle-delta",
      "exactSelectorResolution": "pinned-live-module-graph",
      "packetSchemaId": "asp.source-snapshot.v1",
      "sourceSnapshotEnvelopeSchemaId": "asp.exact-source-snapshot-envelope.v1",
      "derivedArtifactEvidenceSchemaId": "asp.derived-source-artifact-evidence.v1",
      "exactSourcePacketSchemaId": "asp.exact-source-query-result.v1",
      "canonicalItemSelectorSchemaId": "asp.canonical-item-selector.v1"
    }
  },
  "queryPackDescriptor": {
    "descriptorId": "org.query-pack",
    "descriptorVersion": "1",
    "languageId": "org",
    "termRoleOverrides": [
      {
        "term": "heading",
        "role": "concept",
        "caseSensitive": false
      },
      {
        "term": "task",
        "role": "concept",
        "caseSensitive": false
      },
      {
        "term": "property",
        "role": "concept",
        "caseSensitive": false
      },
      {
        "term": "planning",
        "role": "concept",
        "caseSensitive": false
      },
      {
        "term": "table",
        "role": "concept",
        "caseSensitive": false
      },
      {
        "term": "block",
        "role": "concept",
        "caseSensitive": false
      },
      {
        "term": "list",
        "role": "concept",
        "caseSensitive": false
      },
      {
        "term": "link",
        "role": "concept",
        "caseSensitive": false
      },
      {
        "term": "image",
        "role": "concept",
        "caseSensitive": false
      }
    ],
    "recipes": [
      {
        "recipeId": "org-task-planning",
        "trigger": {
          "terms": [
            "task",
            "planning",
            "scheduled",
            "deadline",
            "closed"
          ],
          "match": "any"
        },
        "clauses": [
          {
            "terms": [
              "task",
              "planning",
              "scheduled",
              "deadline",
              "closed"
            ],
            "roles": [
              "concept"
            ],
            "intentAxes": []
          }
        ]
      },
      {
        "recipeId": "org-document-structure",
        "trigger": {
          "terms": [
            "heading",
            "property",
            "tag",
            "title"
          ],
          "match": "any"
        },
        "clauses": [
          {
            "terms": [
              "heading",
              "property",
              "tag",
              "title"
            ],
            "roles": [
              "concept"
            ],
            "intentAxes": []
          }
        ]
      }
    ]
  },
  "policy": {
    "directSourceRead": "block",
    "rawSourceSearch": "block",
    "bulkSourceDump": "block",
    "agentSearchJson": "block"
  },
  "routeBindings": {
    "prime": "search/prime",
    "owner": "search/toc",
    "lexical": "search/lexical",
    "query": "query/exact-selector",
    "ingest": "search/ingest",
    "checkChanged": "search/prime",
    "guide": "guide"
  }
}
