{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-semantic-protocols.dev/schemas/codex-hooks/permission-request-command-output.schema.json",
  "x-agent-semantic-schema-version": 1,
  "title": "permission-request.command.output",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "PermissionRequestBehaviorWire": {
      "type": "string",
      "enum": ["allow", "deny"]
    },
    "PermissionRequestDecisionWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior"],
      "properties": {
        "behavior": { "$ref": "#/definitions/PermissionRequestBehaviorWire" },
        "message": { "default": null, "type": "string" },
        "interrupt": { "default": false, "type": "boolean" },
        "updatedInput": { "default": null },
        "updatedPermissions": { "default": null }
      }
    },
    "PermissionRequestHookSpecificOutputWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hookEventName"],
      "properties": {
        "hookEventName": { "type": "string", "const": "PermissionRequest" },
        "decision": {
          "default": null,
          "allOf": [{ "$ref": "#/definitions/PermissionRequestDecisionWire" }]
        }
      }
    }
  },
  "properties": {
    "continue": { "default": true, "type": "boolean" },
    "hookSpecificOutput": {
      "default": null,
      "allOf": [{ "$ref": "#/definitions/PermissionRequestHookSpecificOutputWire" }]
    },
    "stopReason": { "default": null, "type": "string" },
    "suppressOutput": { "default": false, "type": "boolean" },
    "systemMessage": { "default": null, "type": "string" }
  }
}
