{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-semantic-protocols.dev/schemas/codex-hooks/subagent-start-command-input.schema.json",
  "x-agent-semantic-schema-version": 1,
  "title": "subagent-start.command.input",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "turn_id", "transcript_path", "cwd", "hook_event_name", "model", "permission_mode", "agent_id", "agent_type"],
  "properties": {
    "session_id": {"type": "string"},
    "turn_id": {"type": "string"},
    "transcript_path": {"type": ["string", "null"]},
    "cwd": {"type": "string"},
    "hook_event_name": {"type": "string", "const": "SubagentStart"},
    "model": {"type": "string"},
    "permission_mode": {"type": "string", "enum": ["default", "acceptEdits", "plan", "dontAsk", "bypassPermissions"]},
    "agent_id": {"type": "string"},
    "agent_type": {"type": "string"}
  }
}
